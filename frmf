                }
              ]
            },
            {
              "elmType": "div",
              "children": [
                {
                  "elmType": "div",
                  "txtContent": "Add screenshots",
                  "style": {
                    "font-size": "13px",
                    "font-weight": "700",
                    "color": "#0F172A"
