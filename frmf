                    "font-size": "12px",
                    "color": "#64748B",
                    "margin-top": "3px",
                    "line-height": "1.45"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "elmType": "div",
      "style": {
        "display": "flex",
        "align-items": "center",
        "flex-wrap": "wrap",
        "padding": "14px 18px",
        "border-radius": "12px",
        "background-color": "#1E1B4B",
        "background-image": "linear-gradient(90deg, #1E1B4B 0%, #312E81 100%)"
      },
      "children": [
        {
          "elmType": "span",
          "attributes": {
            "iconName": "Warning"
          },
          "style": {
            "font-size": "16px",
            "color": "#FBBF24",
