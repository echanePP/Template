                    "font-size": "12px",
                    "color": "#64748B",
                    "margin-top": "3px",
                    "line-height": "1.45"
                  }
                }
              ]
            }
          ]
        },
        {
          "elmType": "div",
          "style": {
            "flex": "1 1 200px",
            "display": "flex",
            "align-items": "flex-start",
