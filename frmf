            "href": "mailto:migration@contoso.com?subject=Urgent%20file%20share%20issue",
            "target": "_blank"
          },
          "style": {
            "font-size": "12px",
            "font-weight": "700",
            "color": "#1E1B4B",
            "background-color": "#FFFFFF",
