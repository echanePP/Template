- conRoot:
    Control: GroupContainer
    Variant: AutoLayout
    Properties:
      X: =0
      Y: =0
      Width: =Parent.Width
      Height: =Parent.Height
      Fill: =clrBg
      BorderThickness: =0
      DropShadow: =DropShadow.None
      LayoutDirection: =LayoutDirection.Vertical
      LayoutAlignItems: =LayoutAlignItems.Stretch
      LayoutJustifyContent: =LayoutJustifyContent.Start
      LayoutGap: =20
      LayoutOverflowY: =LayoutOverflow.Scroll
      PaddingTop: =36
      PaddingBottom: =36
      PaddingLeft: =48
      PaddingRight: =48
    Children:
      - conHeader:
          Control: GroupContainer
          Variant: AutoLayout
          Properties:
            Height: =80
            FillPortions: =0
            AlignInContainer: =AlignInContainer.Stretch
            Fill: =RGBA(0, 0, 0, 0)
            BorderThickness: =0
            DropShadow: =DropShadow.None
            LayoutDirection: =LayoutDirection.Horizontal
            LayoutAlignItems: =LayoutAlignItems.Center
            LayoutJustifyContent: =LayoutJustifyContent.SpaceBetween
            LayoutGap: =16
          Children:
            - conTitle:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  Height: =80
                  FillPortions: =1
                  Fill: =RGBA(0, 0, 0, 0)
                  BorderThickness: =0
                  DropShadow: =DropShadow.None
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutGap: =18
                Children:
                  - imgHeartbeat:
                      Control: Image
                      Properties:
                        Width: =56
                        Height: =56
                        FillPortions: =0
                        Image: =svgHeartbeat
                        ImagePosition: =ImagePosition.Fit
                  - conTitleText:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        Height: =64
                        FillPortions: =1
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutJustifyContent: =LayoutJustifyContent.Center
                        LayoutGap: =2
                      Children:
                        - txtTitle:
                            Control: Text
                            Properties:
                              Text: ="Platform health"
                              Size: =30
                              Weight: =FontWeight.Semibold
                              FontColor: =clrInk
                              Height: =40
                        - txtSubtitle:
                            Control: Text
                            Properties:
                              Text: ="Live checks against SharePoint and Power Automate"
                              Size: =14
                              FontColor: =clrMuted
                              Height: =22
            - conStatusPill:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  Width: =290
                  Height: =48
                  FillPortions: =0
                  Fill: |-
                    =If(varSpState = "fail" || varPaState = "fail", RGBA(209, 67, 75, 0.12),
                        If(varSpState = "ok" && varPaState = "ok", RGBA(31, 157, 85, 0.12),
                           RGBA(0, 102, 255, 0.10)))
                  BorderThickness: =0
                  DropShadow: =DropShadow.None
                  RadiusTopLeft: =24
                  RadiusTopRight: =24
                  RadiusBottomLeft: =24
                  RadiusBottomRight: =24
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutJustifyContent: =LayoutJustifyContent.Center
                  LayoutGap: =10
                  PaddingLeft: =18
                  PaddingRight: =18
                Children:
                  - imgPulse:
                      Control: Image
                      Properties:
                        Width: =16
                        Height: =16
                        FillPortions: =0
                        Image: |-
                          ="data:image/svg+xml;utf8," & EncodeUrl(
                              Substitute(svgPulse, "{c}",
                                  If(varSpState = "fail" || varPaState = "fail", "#D1434B",
                                     If(varSpState = "ok" && varPaState = "ok", "#1F9D55", "#0066FF"))))
                        ImagePosition: =ImagePosition.Fit
                  - txtStatus:
                      Control: Text
                      Properties:
                        Text: |-
                          =If(varSpState = "fail" || varPaState = "fail", "Something needs attention",
                              If(varSpState = "ok" && varPaState = "ok", "All systems operational",
                                 If(varSpState = "running" || varPaState = "running", "Checking...", "Ready to check")))
                        Size: =14
                        Weight: =FontWeight.Semibold
                        FontColor: |-
                          =If(varSpState = "fail" || varPaState = "fail", clrFail,
                              If(varSpState = "ok" && varPaState = "ok", clrOk, clrPa))
                        Height: =22
                        FillPortions: =1
      - conEnv:
          Control: GroupContainer
          Variant: AutoLayout
          Properties:
            Height: =156
            FillPortions: =0
            AlignInContainer: =AlignInContainer.Stretch
            Fill: =clrCard
            BorderColor: =clrLine
            BorderThickness: =1
            DropShadow: =DropShadow.None
            RadiusTopLeft: =14
            RadiusTopRight: =14
            RadiusBottomLeft: =14
            RadiusBottomRight: =14
            LayoutDirection: =LayoutDirection.Vertical
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutJustifyContent: =LayoutJustifyContent.Center
            LayoutGap: =12
            PaddingTop: =22
            PaddingBottom: =22
            PaddingLeft: =28
            PaddingRight: =28
          Children:
            - txtEnvHeading:
                Control: Text
                Properties:
                  Text: ="Environment"
                  Size: =17
                  Weight: =FontWeight.Semibold
                  FontColor: =clrInk
                  Height: =24
            - conEnvRow:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  Height: =44
                  FillPortions: =0
                  Fill: =RGBA(0, 0, 0, 0)
                  BorderThickness: =0
                  DropShadow: =DropShadow.None
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutGap: =12
                Children:
                  - ddEnv:
                      Control: Classic/DropDown
                      Properties:
                        Items: =Distinct(fxEnvs, EnvName)
                        Default: =LookUp(fxEnvs, IsDefault).EnvName
                        Width: =420
                        Height: =44
                        FillPortions: =0
                        Size: =13
                        Fill: =RGBA(246, 248, 249, 1)
                        Color: =clrInk
                        BorderColor: =clrLine
                        BorderThickness: =1
                        PaddingLeft: =14
                        ChevronBackground: =RGBA(246, 248, 249, 1)
                        ChevronFill: =clrInk
                        ChevronHoverBackground: =RGBA(236, 240, 242, 1)
                        ChevronHoverFill: =clrInk
                        HoverFill: =RGBA(236, 240, 242, 1)
                        HoverColor: =clrInk
                        PressedFill: =RGBA(236, 240, 242, 1)
                        PressedColor: =clrInk
                        SelectionFill: =clrPa
                        SelectionColor: =RGBA(255, 255, 255, 1)
                  - conChipType:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        Width: =170
                        Height: =32
                        FillPortions: =0
                        Fill: =RGBA(0, 102, 255, 0.08)
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        RadiusTopLeft: =16
                        RadiusTopRight: =16
                        RadiusBottomLeft: =16
                        RadiusBottomRight: =16
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Center
                        PaddingLeft: =12
                        PaddingRight: =12
                      Children:
                        - txtChipType:
                            Control: Text
                            Properties:
                              Text: ="Type: " & Coalesce(LookUp(fxEnvs, EnvName = ddEnv.Selected.Value).EnvType, "-")
                              Size: =13
                              Weight: =FontWeight.Semibold
                              FontColor: =clrPa
                              Align: =Align.Center
                              Height: =20
                              FillPortions: =1
                  - conChipState:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        Width: =170
                        Height: =32
                        FillPortions: =0
                        Fill: |-
                          =If(LookUp(fxEnvs, EnvName = ddEnv.Selected.Value).EnvState = "Succeeded",
                              RGBA(31, 157, 85, 0.10), RGBA(209, 67, 75, 0.10))
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        RadiusTopLeft: =16
                        RadiusTopRight: =16
                        RadiusBottomLeft: =16
                        RadiusBottomRight: =16
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Center
                        PaddingLeft: =12
                        PaddingRight: =12
                      Children:
                        - txtChipState:
                            Control: Text
                            Properties:
                              Text: |-
                                =If(LookUp(fxEnvs, EnvName = ddEnv.Selected.Value).EnvState = "Succeeded",
                                    "Healthy", "State: " & Coalesce(LookUp(fxEnvs, EnvName = ddEnv.Selected.Value).EnvState, "-"))
                              Size: =13
                              Weight: =FontWeight.Semibold
                              FontColor: |-
                                =If(LookUp(fxEnvs, EnvName = ddEnv.Selected.Value).EnvState = "Succeeded", clrOk, clrFail)
                              Align: =Align.Center
                              Height: =20
                              FillPortions: =1
                  - conChipDefault:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        Width: =120
                        Height: =32
                        FillPortions: =0
                        Visible: =LookUp(fxEnvs, EnvName = ddEnv.Selected.Value).IsDefault
                        Fill: =RGBA(27, 42, 51, 0.08)
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        RadiusTopLeft: =16
                        RadiusTopRight: =16
                        RadiusBottomLeft: =16
                        RadiusBottomRight: =16
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Center
                        PaddingLeft: =12
                        PaddingRight: =12
                      Children:
                        - txtChipDefault:
                            Control: Text
                            Properties:
                              Text: ="Default"
                              Size: =13
                              Weight: =FontWeight.Semibold
                              FontColor: =clrInk
                              Align: =Align.Center
                              Height: =20
                              FillPortions: =1
            - txtEnvCount:
                Control: Text
                Properties:
                  Text: |-
                    =CountRows(fxEnvs) & If(CountRows(fxEnvs) = 1, " environment", " environments") & " visible to your account. Pick one to confirm it responds."
                  Size: =13
                  FontColor: =clrMuted
                  Height: =20
      - conChecks:
          Control: GroupContainer
          Variant: AutoLayout
          Properties:
            FillPortions: =1
            AlignInContainer: =AlignInContainer.Stretch
            Fill: =RGBA(0, 0, 0, 0)
            BorderThickness: =0
            DropShadow: =DropShadow.None
            LayoutDirection: =LayoutDirection.Horizontal
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutGap: =20
          Children:
            - conSp:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =1
                  Fill: =clrCard
                  BorderColor: =clrLine
                  BorderThickness: =1
                  DropShadow: =DropShadow.None
                  RadiusTopLeft: =14
                  RadiusTopRight: =14
                  RadiusBottomLeft: =14
                  RadiusBottomRight: =14
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutGap: =16
                  PaddingTop: =28
                  PaddingBottom: =28
                  PaddingLeft: =28
                  PaddingRight: =28
                Children:
                  - conSpHead:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        Height: =44
                        FillPortions: =0
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutGap: =14
                      Children:
                        - imgSpGlyph:
                            Control: Image
                            Properties:
                              Width: =44
                              Height: =44
                              FillPortions: =0
                              Image: =svgSpGlyph
                              ImagePosition: =ImagePosition.Fit
                        - txtSpTitle:
                            Control: Text
                            Properties:
                              Text: ="SharePoint"
                              Size: =20
                              Weight: =FontWeight.Semibold
                              FontColor: =clrInk
                              Height: =30
                              FillPortions: =1
                  - txtSpDesc:
                      Control: Text
                      Properties:
                        Text: ="Writes a test item to the HealthChecks list and confirms the write came back."
                        Size: =14
                        FontColor: =clrMuted
                        Wrap: =true
                        Height: =44
                  - btnSp:
                      Control: Button
                      Properties:
                        Text: =If(varSpState = "running", "Checking...", "Run SharePoint check")
                        Appearance: ='ButtonCanvas.Appearance'.Primary
                        BasePaletteColor: =clrSp
                        Height: =48
                        AlignInContainer: =AlignInContainer.Stretch
                        DisplayMode: =If(varSpState = "running", DisplayMode.Disabled, DisplayMode.Edit)
                        OnSelect: |-
                          =Set(varSpStart, Now());
                          Set(varSpState, "running");
                          Reset(tmrSp);
                          IfError(
                              Patch(
                                  HealthChecks,
                                  Defaults(HealthChecks),
                                  { Title: "Health check by " & User().FullName & " at " & Text(Now(), "yyyy-mm-dd hh:mm:ss") }
                              ),
                              Set(varSpMsg, "SharePoint write failed: " & FirstError.Message);
                              Set(varSpState, "fail"),
                              Set(varSpMsg, "SharePoint is up. Test item written in " & DateDiff(varSpStart, Now(), TimeUnit.Milliseconds) & " ms.");
                              Set(varSpState, "ok")
                          );
                          Set(varSpTime, Now())
                  - conSpResult:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        Height: =64
                        FillPortions: =0
                        Visible: =!IsBlank(varSpState)
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutGap: =14
                      Children:
                        - imgSpStatus:
                            Control: Image
                            Properties:
                              Width: =44
                              Height: =44
                              FillPortions: =0
                              Image: |-
                                =Switch(varSpState,
                                    "running", "data:image/svg+xml;utf8," & EncodeUrl(Substitute(svgSpinner, "{c}", "#038387")),
                                    "ok", svgCheck,
                                    "fail", svgFail)
                              ImagePosition: =ImagePosition.Fit
                        - conSpResultText:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              Height: =64
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              DropShadow: =DropShadow.None
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =2
                            Children:
                              - txtSpMsg:
                                  Control: Text
                                  Properties:
                                    Text: =If(varSpState = "running", "Writing a test item to the HealthChecks list...", varSpMsg)
                                    Size: =15
                                    Weight: =FontWeight.Semibold
                                    Wrap: =true
                                    FontColor: |-
                                      =If(varSpState = "running", clrMuted,
                                          If(varSpState = "fail", RGBA(209, 67, 75, Min(1, tmrSp.Value / 450)),
                                             RGBA(27, 42, 51, Min(1, tmrSp.Value / 450))))
                                    Height: =40
                              - txtSpTime:
                                  Control: Text
                                  Properties:
                                    Text: =If(varSpState in ["ok", "fail"], "Checked at " & Text(varSpTime, "h:mm:ss AM/PM"), "")
                                    Size: =12
                                    FontColor: =RGBA(97, 112, 122, Min(1, tmrSp.Value / 450))
                                    Height: =18
                  - tmrSp:
                      Control: Timer
                      Properties:
                        Duration: =450
                        Repeat: =false
                        AutoStart: =false
                        Start: =varSpState in ["ok", "fail"]
                        Visible: =false
                        Width: =10
                        Height: =10
            - conPa:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =1
                  Fill: =clrCard
                  BorderColor: =clrLine
                  BorderThickness: =1
                  DropShadow: =DropShadow.None
                  RadiusTopLeft: =14
                  RadiusTopRight: =14
                  RadiusBottomLeft: =14
                  RadiusBottomRight: =14
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutGap: =16
                  PaddingTop: =28
                  PaddingBottom: =28
                  PaddingLeft: =28
                  PaddingRight: =28
                Children:
                  - conPaHead:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        Height: =44
                        FillPortions: =0
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutGap: =14
                      Children:
                        - imgPaGlyph:
                            Control: Image
                            Properties:
                              Width: =44
                              Height: =44
                              FillPortions: =0
                              Image: =svgPaGlyph
                              ImagePosition: =ImagePosition.Fit
                        - txtPaTitle:
                            Control: Text
                            Properties:
                              Text: ="Power Automate"
                              Size: =20
                              Weight: =FontWeight.Semibold
                              FontColor: =clrInk
                              Height: =30
                              FillPortions: =1
                  - txtPaDesc:
                      Control: Text
                      Properties:
                        Text: ="Triggers the HealthCheckFlow and waits for it to reply."
                        Size: =14
                        FontColor: =clrMuted
                        Wrap: =true
                        Height: =44
                  - btnPa:
                      Control: Button
                      Properties:
                        Text: =If(varPaState = "running", "Checking...", "Run Power Automate check")
                        Appearance: ='ButtonCanvas.Appearance'.Primary
                        BasePaletteColor: =clrPa
                        Height: =48
                        AlignInContainer: =AlignInContainer.Stretch
                        DisplayMode: =If(varPaState = "running", DisplayMode.Disabled, DisplayMode.Edit)
                        OnSelect: |-
                          =Set(varPaStart, Now());
                          Set(varPaState, "running");
                          Reset(tmrPa);
                          IfError(
                              Set(varPaResult, HealthCheckFlow.Run()),
                              Set(varPaMsg, "Flow call failed: " & FirstError.Message);
                              Set(varPaState, "fail"),
                              Set(varPaMsg, "Power Automate is up and running. Flow replied '" & varPaResult.status & "' in " & DateDiff(varPaStart, Now(), TimeUnit.Milliseconds) & " ms.");
                              Set(varPaState, "ok")
                          );
                          Set(varPaTime, Now())
                  - conPaResult:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        Height: =64
                        FillPortions: =0
                        Visible: =!IsBlank(varPaState)
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutGap: =14
                      Children:
                        - imgPaStatus:
                            Control: Image
                            Properties:
                              Width: =44
                              Height: =44
                              FillPortions: =0
                              Image: |-
                                =Switch(varPaState,
                                    "running", "data:image/svg+xml;utf8," & EncodeUrl(Substitute(svgSpinner, "{c}", "#0066FF")),
                                    "ok", svgCheck,
                                    "fail", svgFail)
                              ImagePosition: =ImagePosition.Fit
                        - conPaResultText:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              Height: =64
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              DropShadow: =DropShadow.None
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =2
                            Children:
                              - txtPaMsg:
                                  Control: Text
                                  Properties:
                                    Text: =If(varPaState = "running", "Waiting for the flow to respond...", varPaMsg)
                                    Size: =15
                                    Weight: =FontWeight.Semibold
                                    Wrap: =true
                                    FontColor: |-
                                      =If(varPaState = "running", clrMuted,
                                          If(varPaState = "fail", RGBA(209, 67, 75, Min(1, tmrPa.Value / 450)),
                                             RGBA(27, 42, 51, Min(1, tmrPa.Value / 450))))
                                    Height: =40
                              - txtPaTime:
                                  Control: Text
                                  Properties:
                                    Text: =If(varPaState in ["ok", "fail"], "Checked at " & Text(varPaTime, "h:mm:ss AM/PM"), "")
                                    Size: =12
                                    FontColor: =RGBA(97, 112, 122, Min(1, tmrPa.Value / 450))
                                    Height: =18
                  - tmrPa:
                      Control: Timer
                      Properties:
                        Duration: =450
                        Repeat: =false
                        AutoStart: =false
                        Start: =varPaState in ["ok", "fail"]
                        Visible: =false
                        Width: =10
                        Height: =10
