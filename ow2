                              FontColor: =nfMuted
                              Wrap: =true

      # ---------------- Confirmation dialog (overlay) ----------------
      - conScrim:
          Control: GroupContainer
          Variant: ManualLayout
          Properties:
            X: =0
            Y: =0
            Width: =Parent.Width
            Height: =Parent.Height
            Visible: =varShowConfirm
            Fill: =RGBA(17, 24, 39, 0.55)
            BorderThickness: =0
          Children:
            - conDialog:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  X: =(Parent.Width - Self.Width) / 2
                  Y: =(Parent.Height - Self.Height) / 2
                  Width: =Min(560, Parent.Width - 32)
                  Height: =528
                  Fill: =nfWhite
                  BorderThickness: =0
                  DropShadow: =DropShadow.Bold
                  RadiusTopLeft: =20
                  RadiusTopRight: =20
                  RadiusBottomLeft: =20
                  RadiusBottomRight: =20
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =0
                Children:
                  - conDialogStrip:
                      Control: GroupContainer
                      Variant: ManualLayout
                      Properties:
                        FillPortions: =0
                        Height: =8
                        Fill: =If(varChoice = "Preferred", nfAccent, nfPrimary)
                        BorderThickness: =0
                        RadiusTopLeft: =20
                        RadiusTopRight: =20
                        RadiusBottomLeft: =0
                        RadiusBottomRight: =0
                  - conDialogBody:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =1
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =8
                        PaddingLeft: =36
                        PaddingRight: =36
                        PaddingTop: =28
                        PaddingBottom: =8
                      Children:
                        - txtDialogEyebrow:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =18
                              Text: =If(varChoice = "Preferred", "USE A DIFFERENT SITE", "CONFIRM DESTINATION")
                              Size: =11
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =If(varChoice = "Preferred", nfAccent, nfPrimary)
                              Wrap: =false
                        - txtDialogTitle:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =34
                              Text: =If(varChoice = "Preferred", "Point this file share to a site you own", "Confirm the auto-created site")
                              Size: =22
                              Weight: ='TextCanvas.Weight'.Bold
                              FontColor: =nfInk
                              Wrap: =false
                        - txtDialogPathLabel:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =24
                              PaddingTop: =8
                              Text: ="FILE SHARE"
                              Size: =11
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfMuted
                              Wrap: =false
                        - txtDialogPath:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =22
                              Text: =varConfirmPath
                              Size: =14
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfInk
                              Wrap: =false
                        - txtDialogAnswers:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =20
                              Text: |-
                                =With(
                                    {_a: LookUp(colAnswers, ID = varConfirmId)},
                                    "Still needed · " & _a.Need & "    Share type · " & _a.Type & "    Retain permissions · " & _a.Retain
                                )
                              Size: =12
                              FontColor: =nfMuted
                              Wrap: =false
                        - txtDialogUrlLabel:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =24
                              PaddingTop: =8
                              Text: =If(varChoice = "Preferred", "SHAREPOINT SITE URL YOU OWN", "DESTINATION SITE")
                              Size: =11
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfMuted
                              Wrap: =false
                        - txtDialogUrl:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =44
                              Visible: =varChoice = "Existing"
                              Text: =varTargetUrl
                              Size: =14
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfPrimary
                              Wrap: =true
                        - txtPreferredUrl:
                            Control: TextInput
                            Properties:
                              FillPortions: =0
                              Height: =40
                              Visible: =varChoice = "Preferred"
                              Value: =""
                              Placeholder: ="https://contoso.sharepoint.com/sites/your-site"
                        - txtUrlError:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =18
                              Visible: |-
                                =varChoice = "Preferred"
                                && !IsBlank(txtPreferredUrl.Value)
                                && !With(
                                    {_u: Lower(Trim(txtPreferredUrl.Value))},
                                    StartsWith(_u, "https://") && (".sharepoint.com/sites/" in _u || ".sharepoint.com/teams/" in _u)
                                )
                              Text: ="Enter the full site URL, e.g. https://contoso.sharepoint.com/sites/… or /teams/…"
                              Size: =12
                              FontColor: =nfDanger
                              Wrap: =false
                        - conWarning:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =0
                              Height: =112
                              Fill: =nfWarningBg
                              BorderColor: =nfWarning
                              BorderThickness: =1
                              RadiusTopLeft: =12
                              RadiusTopRight: =12
                              RadiusBottomLeft: =12
                              RadiusBottomRight: =12
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Start
                              LayoutGap: =4
                              PaddingLeft: =16
                              PaddingRight: =16
                              PaddingTop: =12
                              PaddingBottom: =12
                            Children:
                              - txtWarnTitle:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =18
                                    Text: ="Before you confirm"
                                    Size: =12
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfWarningText
                                    Wrap: =false
                              - txtWarnBody:
                                  Control: Text
                                  Properties:
                                    FillPortions: =1
                                    Text: |-
                                      =If(
                                          varChoice = "Preferred",
                                          "Are you sure you are the owner of the site you have provided, or have permission from the site owner to migrate this data to their site? Your confirmation is recorded with your name and today's date, and the other owners of this file share will see it.",
                                          "Are you sure you are an owner of this site, or have permission from the site owner, to migrate this file share to it? Your confirmation is recorded with your name and today's date, and the other owners of this file share will see it."
                                      )
                                    Size: =13
                                    FontColor: =nfWarningText
                                    Wrap: =true
                  - conDialogFooter:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =84
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.End
                        LayoutGap: =12
                        PaddingLeft: =36
                        PaddingRight: =36
                        PaddingTop: =16
                        PaddingBottom: =28
                      Children:
                        - txtSaving:
                            Control: Text
                            Properties:
                              FillPortions: =1
                              Height: =40
                              Visible: =varBusy
                              Text: ="Saving your selection…"
                              Size: =13
                              FontColor: =nfMuted
                              VerticalAlign: =VerticalAlign.Middle
                              Wrap: =false
                        - btnCancel:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =124
                              Height: =40
                              Text: ="Cancel"
                              Appearance: ='ButtonCanvas.Appearance'.Secondary
                              Layout: ='ButtonCanvas.Layout'.TextOnly
                              DisplayMode: =If(varBusy, DisplayMode.Disabled, DisplayMode.Edit)
                              OnSelect: =Set(varShowConfirm, false)
                        - btnConfirm:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =176
                              Height: =40
                              Text: ="Yes, I confirm"
                              Appearance: ='ButtonCanvas.Appearance'.Primary
                              Layout: ='ButtonCanvas.Layout'.IconBefore
                              Icon: ="Checkmark"
                              BasePaletteColor: =If(varChoice = "Preferred", nfAccent, nfPrimary)
                              DisplayMode: |-
                                =If(
                                    varBusy,
                                    DisplayMode.Disabled,
                                    If(
                                        varChoice = "Preferred",
                                        If(
                                            With(
                                                {_u: Lower(Trim(txtPreferredUrl.Value))},
                                                StartsWith(_u, "https://") && (".sharepoint.com/sites/" in _u || ".sharepoint.com/teams/" in _u)
                                            ),
                                            DisplayMode.Edit,
                                            DisplayMode.Disabled
                                        ),
                                        DisplayMode.Edit
                                    )
                                )
                              OnSelect: |-
                                =Set(varBusy, true);
                                With(
                                    {
                                        _url: If(varChoice = "Preferred", Trim(txtPreferredUrl.Value), varTargetUrl),
                                        _latest: LookUp(migration, ID = varConfirmId),
                                        _a: LookUp(colAnswers, ID = varConfirmId)
                                    },
                                    If(
                                        _latest.OwnerConfirmed && Lower(Coalesce(_latest.ConfirmedByEmail, "")) <> nfMe,
                                        Notify("Selection has already been submitted by the other owner (" & _latest.ConfirmedBy & ").", NotificationType.Warning),
                                        Patch(
                                            migration,
                                            {ID: varConfirmId},
                                            {
                                                PreferredSharePointURL: If(varChoice = "Preferred", _url, Blank()),
                                                NeedFileShare: {Value: _a.Need},
                                                ShareType: {Value: _a.Type},
                                                RetainPermissions: {Value: _a.Retain},
                                                OwnerConfirmed: true,
                                                ConfirmedBy: User().FullName,
                                                ConfirmedByEmail: User().Email,
                                                ConfirmedOn: Now()
                                            }
                                        );
                                        Notify("Thanks — your selection for " & varConfirmPath & " has been recorded.", NotificationType.Success)
                                    )
                                );
                                Refresh(migration);
                                Set(varBusy, false);
                                Set(varShowConfirm, false)

