                                                              Layout: =If(LookUp(colAnswers, ID = ThisItem.ID).Retain = "Yes", 'ButtonCanvas.Layout'.IconBefore, 'ButtonCanvas.Layout'.TextOnly)
                                                              Icon: ="Checkmark"
                                                              BasePaletteColor: =nfPrimary
                                                              DisplayMode: =If(Coalesce(ThisItem.OwnerConfirmed, false), DisplayMode.Disabled, DisplayMode.Edit)
                                                              OnSelect: |-
                                                                =If(
                                                                    IsBlank(LookUp(colAnswers, ID = ThisItem.ID)),
                                                                    Collect(colAnswers, {ID: ThisItem.ID, Need: "", Type: "", Retain: ""})
                                                                );
                                                                Patch(colAnswers, LookUp(colAnswers, ID = ThisItem.ID), {Retain: "Yes"})
                                                        - btnRetainB:
                                                            Control: Button
                                                            Properties:
                                                              FillPortions: =1
                                                              Height: =36
                                                              Text: ="No"
                                                              Appearance: =If(LookUp(colAnswers, ID = ThisItem.ID).Retain = "No", 'ButtonCanvas.Appearance'.Primary, 'ButtonCanvas.Appearance'.Outline)
                                                              Layout: =If(LookUp(colAnswers, ID = ThisItem.ID).Retain = "No", 'ButtonCanvas.Layout'.IconBefore, 'ButtonCanvas.Layout'.TextOnly)
                                                              Icon: ="Checkmark"
                                                              BasePaletteColor: =nfPrimary
                                                              DisplayMode: =If(Coalesce(ThisItem.OwnerConfirmed, false), DisplayMode.Disabled, DisplayMode.Edit)
                                                              OnSelect: |-
                                                                =If(
                                                                    IsBlank(LookUp(colAnswers, ID = ThisItem.ID)),
                                                                    Collect(colAnswers, {ID: ThisItem.ID, Need: "", Type: "", Retain: ""})
                                                                );
                                                                Patch(colAnswers, LookUp(colAnswers, ID = ThisItem.ID), {Retain: "No"})
                                    # ---- actions ----
                                    - conActionRow:
                                        Control: GroupContainer
                                        Variant: AutoLayout
                                        Properties:
                                          FillPortions: =0
                                          Height: =40
                                          Fill: =RGBA(0, 0, 0, 0)
                                          BorderThickness: =0
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutAlignItems: =LayoutAlignItems.Center
                                          LayoutJustifyContent: =LayoutJustifyContent.Start
                                          LayoutGap: =10
                                        Children:
                                          - txtRequiredHint:
                                              Control: Text
                                              Properties:
                                                FillPortions: =1
                                                Height: =40
                                                Visible: =!Coalesce(ThisItem.OwnerConfirmed, false)
                                                Text: =If((!IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Need) && !IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Type) && !IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Retain)), "All set — confirm the auto-created site, or point this share to a different one.", "Answer the three questions above to continue.")
                                                Size: =12
                                                FontColor: =If((!IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Need) && !IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Type) && !IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Retain)), nfMuted, nfWarningText)
                                                VerticalAlign: =VerticalAlign.Middle
                                                Wrap: =false
                                          - txtConfirmedMsg:
                                              Control: Text
                                              Properties:
                                                FillPortions: =1
                                                Height: =40
                                                Visible: =Coalesce(ThisItem.OwnerConfirmed, false)
                                                Text: |-
                                                  =If(
                                                      Lower(Coalesce(ThisItem.ConfirmedByEmail, "")) = nfMe,
                                                      "You confirmed this selection on " & Text(ThisItem.ConfirmedOn, "mmm d, yyyy") & ".",
                                                      "Selection has been submitted by the other owner (" & ThisItem.ConfirmedBy & ") on the app on " & Text(ThisItem.ConfirmedOn, "mmm d, yyyy") & "."
                                                  )
