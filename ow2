Screens:

  scrMigration:
    Properties:
      Fill: =nfPageBg
      OnVisible: |-
        =ClearCollect(
            colAnswers,
            ForAll(
                nfMySites,
                {ID: ID, Need: Coalesce(NeedFileShare.Value, ""), Type: Coalesce(ShareType.Value, ""), Retain: Coalesce(RetainPermissions.Value, "")}
            )
        )
    Children:
      - conPage:
          Control: GroupContainer
          Variant: AutoLayout
          Properties:
            X: =0
            Y: =0
            Width: =Parent.Width
            Height: =Parent.Height
            Fill: =nfPageBg
            BorderThickness: =0
            LayoutDirection: =LayoutDirection.Vertical
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutJustifyContent: =LayoutJustifyContent.Start
            LayoutGap: =0
          Children:

            # ---------------- Top bar ----------------
            - conTopBar:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =0
                  Height: =64
                  Fill: =nfWhite
                  BorderThickness: =0
                  DropShadow: =DropShadow.Light
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =16
                  PaddingLeft: =24
                  PaddingRight: =24
                Children:
                  - conBrand:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =1
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =12
                      Children:
                        - imgLogo:
                            Control: Image
                            Properties:
                              FillPortions: =0
                              Width: =36
                              Height: =36
                              ImagePosition: =ImagePosition.Fit
                              Image: |-
                                ="data:image/svg+xml;utf8," & EncodeUrl("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 36'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#4F46E5'/><stop offset='1' stop-color='#DB2777'/></linearGradient></defs><rect width='36' height='36' rx='10' fill='url(#g)'/><path d='M9 12.5h7l2 2.5h9v9.5H9z' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linejoin='round'/><path d='M18 23v-5.5M15.5 20l2.5-2.5 2.5 2.5' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>")
                        - conBrandText:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =0
                            Children:
                              - txtBrand:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =20
                                    Text: ="Migration Hub"
                                    Size: =15
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfInk
                                    Wrap: =false
                              - txtBrandSub:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =16
                                    Text: ="File share migration · owner confirmation"
                                    Size: =11
                                    FontColor: =nfMuted
                                    Wrap: =false
                  - btnAdmin:
                      Control: Button
                      Properties:
                        FillPortions: =0
                        Width: =110
                        Height: =36
                        Visible: =nfIsAdmin
                        Text: ="Admin"
                        Appearance: ='ButtonCanvas.Appearance'.Secondary
                        Layout: ='ButtonCanvas.Layout'.IconBefore
                        Icon: ="Settings"
                        BasePaletteColor: =nfPrimary
                        OnSelect: =Navigate(scrAdminWaves)
                  - conUserChip:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Width: =240
                        Height: =44
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.End
                        LayoutGap: =10
                      Children:
                        - conChipText:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =0
                            Children:
                              - txtChipName:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =18
                                    Text: =User().FullName
                                    Size: =13
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfInk
                                    Align: ='TextCanvas.Align'.End
                                    Wrap: =false
                              - txtChipEmail:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =16
                                    Text: =User().Email
                                    Size: =11
                                    FontColor: =nfMuted
                                    Align: ='TextCanvas.Align'.End
                                    Wrap: =false
                        - conAvatar:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =0
                              Width: =36
                              Height: =36
                              Fill: =nfPrimary
                              BorderThickness: =0
                              RadiusTopLeft: =18
                              RadiusTopRight: =18
                              RadiusBottomLeft: =18
                              RadiusBottomRight: =18
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                            Children:
                              - txtInitials:
                                  Control: Text
                                  Properties:
                                    FillPortions: =1
                                    Text: =Upper(Left(User().FullName, 1) & Left(Last(Split(User().FullName, " ")).Value, 1))
                                    Size: =13
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfWhite
                                    Align: ='TextCanvas.Align'.Center
                                    VerticalAlign: =VerticalAlign.Middle
                                    Wrap: =false

            # ---------------- Body ----------------
            - conBody:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =1
                  Fill: =RGBA(0, 0, 0, 0)
                  BorderThickness: =0
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =12
                  PaddingLeft: =48
                  PaddingRight: =48
                  PaddingTop: =28
                  PaddingBottom: =24
                Children:
                  - conHero:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =72
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =16
                      Children:
                        - conHeroText:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =4
                            Children:
                              - txtTitle:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =36
                                    Text: ="Destination site confirmation"
                                    Size: =26
                                    Weight: ='TextCanvas.Weight'.Bold
                                    FontColor: =nfInk
                                    Wrap: =false
                              - txtSubtitle:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =22
                                    Text: ="Hi " & User().FullName & " — review each file share you own and confirm where it should land in SharePoint."
                                    Size: =14
                                    FontColor: =nfMuted
                                    Wrap: =false
                        - pillOpenWaves:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =0
                              Width: =260
                              Height: =32
                              AlignInContainer: =AlignInContainer.Center
                              Fill: =RGBA(79, 70, 229, 0.12)
                              BorderThickness: =0
                              RadiusTopLeft: =16
                              RadiusTopRight: =16
                              RadiusBottomLeft: =16
                              RadiusBottomRight: =16
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                            Children:
                              - txtOpenWaves:
                                  Control: Text
                                  Properties:
                                    FillPortions: =1
                                    Text: ="Open now · " & nfActiveWaveText
                                    Size: =12
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfPrimary
                                    Align: ='TextCanvas.Align'.Center
                                    VerticalAlign: =VerticalAlign.Middle
                                    Wrap: =false
                  - conSectionHead:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =32
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =12
                      Children:
                        - txtSectionTitle:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Width: =180
                              Height: =32
                              Text: ="Your file shares"
                              Size: =20
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfInk
                              VerticalAlign: =VerticalAlign.Middle
                              Wrap: =false
                        - pillCount:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =0
                              Width: =140
                              Height: =26
                              AlignInContainer: =AlignInContainer.Center
                              Fill: =RGBA(79, 70, 229, 0.12)
                              BorderThickness: =0
                              RadiusTopLeft: =13
                              RadiusTopRight: =13
                              RadiusBottomLeft: =13
                              RadiusBottomRight: =13
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                            Children:
                              - txtCount:
                                  Control: Text
                                  Properties:
                                    FillPortions: =1
                                    Text: =CountRows(galSites.AllItems) & If(CountRows(galSites.AllItems) = 1, " file share", " file shares")
                                    Size: =12
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfPrimary
                                    Align: ='TextCanvas.Align'.Center
                                    VerticalAlign: =VerticalAlign.Middle
                                    Wrap: =false
                  - txtSectionHint:
                      Control: Text
                      Properties:
                        FillPortions: =0
                        Height: =22
                        Text: ="Confirm the auto-created site for each share, or point it to an existing site you own. Once one owner submits, the choice is locked for the other owners."
                        Size: =13
                        FontColor: =nfMuted
                        Wrap: =false

                  # ---------------- Gallery of owned shares ----------------
                  - galSites:
                      Control: Gallery
                      Variant: Vertical
                      Properties:
                        FillPortions: =1
                        Items: =nfMySites
                        TemplateSize: =330
                        TemplatePadding: =0
                        ShowScrollbar: =false
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LoadingSpinner: =LoadingSpinner.Data
                        LoadingSpinnerColor: =nfPrimary
                      Children:
                        - conCard:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              X: =4
                              Y: =6
                              Width: =Parent.TemplateWidth - 8
                              Height: =Parent.TemplateHeight - 14
                              Fill: =nfWhite
                              BorderThickness: =0
                              DropShadow: =DropShadow.Light
                              RadiusTopLeft: =16
                              RadiusTopRight: =16
                              RadiusBottomLeft: =16
                              RadiusBottomRight: =16
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Start
                              LayoutGap: =0
                            Children:
                              - conAccent:
                                  Control: GroupContainer
                                  Variant: ManualLayout
                                  Properties:
                                    FillPortions: =0
                                    Width: =8
                                    Fill: =If(ThisItem.OwnerConfirmed, nfSuccess, nfWarning)
                                    BorderThickness: =0
                                    RadiusTopLeft: =16
                                    RadiusBottomLeft: =16
                                    RadiusTopRight: =0
                                    RadiusBottomRight: =0
                              - conCardBody:
                                  Control: GroupContainer
                                  Variant: AutoLayout
                                  Properties:
                                    FillPortions: =1
                                    Fill: =RGBA(0, 0, 0, 0)
                                    BorderThickness: =0
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutAlignItems: =LayoutAlignItems.Stretch
                                    LayoutJustifyContent: =LayoutJustifyContent.Start
                                    LayoutGap: =12
                                    PaddingLeft: =24
                                    PaddingRight: =24
                                    PaddingTop: =18
                                    PaddingBottom: =18
                                  Children:
                                    # ---- header: path + pills ----
                                    - conHeadRow:
                                        Control: GroupContainer
                                        Variant: AutoLayout
                                        Properties:
                                          FillPortions: =0
                                          Height: =30
                                          Fill: =RGBA(0, 0, 0, 0)
                                          BorderThickness: =0
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutAlignItems: =LayoutAlignItems.Center
                                          LayoutJustifyContent: =LayoutJustifyContent.Start
                                          LayoutGap: =10
                                        Children:
                                          - txtPath:
                                              Control: Text
                                              Properties:
                                                FillPortions: =1
                                                Height: =28
                                                Text: =ThisItem.FileSharePath
                                                Size: =17
                                                Weight: ='TextCanvas.Weight'.Semibold
                                                FontColor: =nfInk
                                                VerticalAlign: =VerticalAlign.Middle
                                                Wrap: =false
                                          - pillWave:
                                              Control: GroupContainer
                                              Variant: AutoLayout
                                              Properties:
                                                FillPortions: =0
                                                Width: =96
                                                Height: =28
                                                Fill: =RGBA(79, 70, 229, 0.12)
                                                BorderThickness: =0
                                                RadiusTopLeft: =14
                                                RadiusTopRight: =14
                                                RadiusBottomLeft: =14
                                                RadiusBottomRight: =14
                                                LayoutDirection: =LayoutDirection.Horizontal
                                                LayoutAlignItems: =LayoutAlignItems.Stretch
                                                LayoutJustifyContent: =LayoutJustifyContent.Center
                                              Children:
                                                - txtWave:
                                                    Control: Text
                                                    Properties:
                                                      FillPortions: =1
                                                      Text: =ThisItem.Wave
                                                      Size: =12
                                                      Weight: ='TextCanvas.Weight'.Semibold
                                                      FontColor: =nfPrimary
                                                      Align: ='TextCanvas.Align'.Center
                                                      VerticalAlign: =VerticalAlign.Middle
                                                      Wrap: =false
                                          - pillStatus:
                                              Control: GroupContainer
                                              Variant: AutoLayout
                                              Properties:
                                                FillPortions: =0
                                                Width: =236
                                                Height: =28
                                                Fill: =If(ThisItem.OwnerConfirmed, RGBA(22, 163, 74, 0.14), RGBA(245, 158, 11, 0.18))
                                                BorderThickness: =0
                                                RadiusTopLeft: =14
                                                RadiusTopRight: =14
                                                RadiusBottomLeft: =14
                                                RadiusBottomRight: =14
                                                LayoutDirection: =LayoutDirection.Horizontal
                                                LayoutAlignItems: =LayoutAlignItems.Stretch
                                                LayoutJustifyContent: =LayoutJustifyContent.Center
                                              Children:
                                                - txtStatus:
                                                    Control: Text
                                                    Properties:
                                                      FillPortions: =1
                                                      Text: |-
                                                        =If(
                                                            ThisItem.OwnerConfirmed,
                                                            If(
                                                                Lower(Coalesce(ThisItem.ConfirmedByEmail, "")) = nfMe,
                                                                "Confirmed by you",
                                                                "Confirmed by " & ThisItem.ConfirmedBy
                                                            ),
                                                            "Awaiting your confirmation"
                                                        )
                                                      Size: =12
                                                      Weight: ='TextCanvas.Weight'.Semibold
                                                      FontColor: =If(ThisItem.OwnerConfirmed, nfSuccessText, nfWarningText)
                                                      Align: ='TextCanvas.Align'.Center
                                                      VerticalAlign: =VerticalAlign.Middle
                                                      Wrap: =false
                                    # ---- owners ----
                                    - txtOwners:
                                        Control: Text
                                        Properties:
                                          FillPortions: =0
                                          Height: =18
                                          Text: ="Owners · " & Concat(ThisItem.Owners, DisplayName, ", ")
                                          Size: =12
                                          FontColor: =nfMuted
                                          Wrap: =false
                                    # ---- destination ----
                                    - conDestRow:
                                        Control: GroupContainer
                                        Variant: AutoLayout
                                        Properties:
                                          FillPortions: =0
                                          Height: =30
                                          Fill: =RGBA(0, 0, 0, 0)
                                          BorderThickness: =0
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutAlignItems: =LayoutAlignItems.Center
                                          LayoutJustifyContent: =LayoutJustifyContent.Start
                                          LayoutGap: =10
                                        Children:
                                          - txtDestLabel:
                                              Control: Text
                                              Properties:
                                                FillPortions: =0
                                                Width: =118
                                                Height: =22
                                                Text: ="DESTINATION SITE"
                                                Size: =11
                                                Weight: ='TextCanvas.Weight'.Semibold
                                                FontColor: =nfMuted
                                                VerticalAlign: =VerticalAlign.Middle
                                                Wrap: =false
                                          - txtDestUrl:
                                              Control: Text
                                              Properties:
                                                FillPortions: =1
                                                Height: =22
                                                Text: =Coalesce(ThisItem.PreferredSharePointURL, ThisItem.SharePointURL, nfSiteRoot & ThisItem.SecurityGroup)
                                                Size: =14
                                                Weight: ='TextCanvas.Weight'.Semibold
                                                FontColor: =nfPrimary
                                                VerticalAlign: =VerticalAlign.Middle
                                                Wrap: =false
                                          - btnOpenSite:
                                              Control: Button
                                              Properties:
                                                FillPortions: =0
                                                Width: =110
                                                Height: =30
                                                Text: ="Open site"
                                                Appearance: ='ButtonCanvas.Appearance'.Subtle
                                                Layout: ='ButtonCanvas.Layout'.IconBefore
                                                Icon: ="Open"
                                                BasePaletteColor: =nfPrimary
                                                OnSelect: =Launch(Coalesce(ThisItem.PreferredSharePointURL, ThisItem.SharePointURL, nfSiteRoot & ThisItem.SecurityGroup))
                                    - txtDestNote:
                                        Control: Text
                                        Properties:
                                          FillPortions: =0
                                          Height: =16
                                          Text: |-
                                            =If(
                                                !IsBlank(ThisItem.PreferredSharePointURL),
                                                "Owner-provided site · replaces the auto-created " & ThisItem.SharePointURL,
                                                "Auto-created site · security group " & ThisItem.SecurityGroup
                                            )
                                          Size: =12
                                          FontColor: =nfMuted
                                          Wrap: =false
                                    - conDivider:
                                        Control: GroupContainer
                                        Variant: ManualLayout
                                        Properties:
                                          FillPortions: =0
                                          Height: =1
                                          Fill: =nfLine
                                          BorderThickness: =0
                                    # ---- required questions ----
                                    - conQuestions:
                                        Control: GroupContainer
                                        Variant: AutoLayout
                                        Properties:
                                          FillPortions: =0
                                          Height: =58
                                          Fill: =RGBA(0, 0, 0, 0)
                                          BorderThickness: =0
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutAlignItems: =LayoutAlignItems.Stretch
                                          LayoutJustifyContent: =LayoutJustifyContent.Start
                                          LayoutGap: =24
                                        Children:
                                            - conQNeed:
                                                Control: GroupContainer
                                                Variant: AutoLayout
                                                Properties:
                                                  FillPortions: =1
                                                  Fill: =RGBA(0, 0, 0, 0)
                                                  BorderThickness: =0
                                                  LayoutDirection: =LayoutDirection.Vertical
                                                  LayoutAlignItems: =LayoutAlignItems.Stretch
                                                  LayoutJustifyContent: =LayoutJustifyContent.Start
                                                  LayoutGap: =6
                                                Children:
                                                  - txtQNeed:
                                                      Control: Text
                                                      Properties:
                                                        FillPortions: =0
                                                        Height: =16
                                                        Text: ="IS THIS FILE SHARE STILL NEEDED?"
                                                        Size: =11
                                                        Weight: ='TextCanvas.Weight'.Semibold
                                                        FontColor: =If(IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Need) && !Coalesce(ThisItem.OwnerConfirmed, false), nfWarningText, nfMuted)
                                                        Wrap: =false
                                                  - conSegNeed:
                                                      Control: GroupContainer
                                                      Variant: AutoLayout
                                                      Properties:
                                                        FillPortions: =0
                                                        Height: =36
                                                        Fill: =RGBA(0, 0, 0, 0)
                                                        BorderThickness: =0
                                                        LayoutDirection: =LayoutDirection.Horizontal
                                                        LayoutAlignItems: =LayoutAlignItems.Stretch
                                                        LayoutJustifyContent: =LayoutJustifyContent.Start
                                                        LayoutGap: =6
                                                      Children:
                                                        - btnNeedA:
                                                            Control: Button
                                                            Properties:
                                                              FillPortions: =1
                                                              Height: =36
                                                              Text: ="Yes"
                                                              Appearance: =If(LookUp(colAnswers, ID = ThisItem.ID).Need = "Yes", 'ButtonCanvas.Appearance'.Primary, 'ButtonCanvas.Appearance'.Outline)
                                                              Layout: =If(LookUp(colAnswers, ID = ThisItem.ID).Need = "Yes", 'ButtonCanvas.Layout'.IconBefore, 'ButtonCanvas.Layout'.TextOnly)
                                                              Icon: ="Checkmark"
                                                              BasePaletteColor: =nfPrimary
                                                              DisplayMode: =If(Coalesce(ThisItem.OwnerConfirmed, false), DisplayMode.Disabled, DisplayMode.Edit)
                                                              OnSelect: |-
                                                                =If(
                                                                    IsBlank(LookUp(colAnswers, ID = ThisItem.ID)),
                                                                    Collect(colAnswers, {ID: ThisItem.ID, Need: "", Type: "", Retain: ""})
                                                                );
                                                                Patch(colAnswers, LookUp(colAnswers, ID = ThisItem.ID), {Need: "Yes"})
                                                        - btnNeedB:
                                                            Control: Button
                                                            Properties:
                                                              FillPortions: =1
                                                              Height: =36
                                                              Text: ="No"
                                                              Appearance: =If(LookUp(colAnswers, ID = ThisItem.ID).Need = "No", 'ButtonCanvas.Appearance'.Primary, 'ButtonCanvas.Appearance'.Outline)
                                                              Layout: =If(LookUp(colAnswers, ID = ThisItem.ID).Need = "No", 'ButtonCanvas.Layout'.IconBefore, 'ButtonCanvas.Layout'.TextOnly)
                                                              Icon: ="Checkmark"
                                                              BasePaletteColor: =nfPrimary
                                                              DisplayMode: =If(Coalesce(ThisItem.OwnerConfirmed, false), DisplayMode.Disabled, DisplayMode.Edit)
                                                              OnSelect: |-
                                                                =If(
                                                                    IsBlank(LookUp(colAnswers, ID = ThisItem.ID)),
                                                                    Collect(colAnswers, {ID: ThisItem.ID, Need: "", Type: "", Retain: ""})
                                                                );
                                                                Patch(colAnswers, LookUp(colAnswers, ID = ThisItem.ID), {Need: "No"})
                                            - conQType:
                                                Control: GroupContainer
                                                Variant: AutoLayout
                                                Properties:
                                                  FillPortions: =1
                                                  Fill: =RGBA(0, 0, 0, 0)
                                                  BorderThickness: =0
                                                  LayoutDirection: =LayoutDirection.Vertical
                                                  LayoutAlignItems: =LayoutAlignItems.Stretch
                                                  LayoutJustifyContent: =LayoutJustifyContent.Start
                                                  LayoutGap: =6
                                                Children:
                                                  - txtQType:
                                                      Control: Text
                                                      Properties:
                                                        FillPortions: =0
                                                        Height: =16
                                                        Text: ="ARCHIVE OR ACTIVE SHARE?"
                                                        Size: =11
                                                        Weight: ='TextCanvas.Weight'.Semibold
                                                        FontColor: =If(IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Type) && !Coalesce(ThisItem.OwnerConfirmed, false), nfWarningText, nfMuted)
                                                        Wrap: =false
                                                  - conSegType:
                                                      Control: GroupContainer
                                                      Variant: AutoLayout
                                                      Properties:
                                                        FillPortions: =0
                                                        Height: =36
                                                        Fill: =RGBA(0, 0, 0, 0)
                                                        BorderThickness: =0
                                                        LayoutDirection: =LayoutDirection.Horizontal
                                                        LayoutAlignItems: =LayoutAlignItems.Stretch
                                                        LayoutJustifyContent: =LayoutJustifyContent.Start
                                                        LayoutGap: =6
                                                      Children:
                                                        - btnTypeA:
                                                            Control: Button
                                                            Properties:
                                                              FillPortions: =1
                                                              Height: =36
                                                              Text: ="Active"
                                                              Appearance: =If(LookUp(colAnswers, ID = ThisItem.ID).Type = "Active", 'ButtonCanvas.Appearance'.Primary, 'ButtonCanvas.Appearance'.Outline)
                                                              Layout: =If(LookUp(colAnswers, ID = ThisItem.ID).Type = "Active", 'ButtonCanvas.Layout'.IconBefore, 'ButtonCanvas.Layout'.TextOnly)
                                                              Icon: ="Checkmark"
                                                              BasePaletteColor: =nfPrimary
                                                              DisplayMode: =If(Coalesce(ThisItem.OwnerConfirmed, false), DisplayMode.Disabled, DisplayMode.Edit)
                                                              OnSelect: |-
                                                                =If(
                                                                    IsBlank(LookUp(colAnswers, ID = ThisItem.ID)),
                                                                    Collect(colAnswers, {ID: ThisItem.ID, Need: "", Type: "", Retain: ""})
                                                                );
                                                                Patch(colAnswers, LookUp(colAnswers, ID = ThisItem.ID), {Type: "Active"})
                                                        - btnTypeB:
                                                            Control: Button
                                                            Properties:
                                                              FillPortions: =1
                                                              Height: =36
                                                              Text: ="Archive"
                                                              Appearance: =If(LookUp(colAnswers, ID = ThisItem.ID).Type = "Archive", 'ButtonCanvas.Appearance'.Primary, 'ButtonCanvas.Appearance'.Outline)
