                                                        Weight: ='TextCanvas.Weight'.Semibold
                                                        FontColor: =If(IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Retain) && !Coalesce(ThisItem.OwnerConfirmed, false), nfWarningText, nfMuted)
