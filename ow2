                                                FontColor: =nfInk
                                                VerticalAlign: =VerticalAlign.Middle
                                                Wrap: =true
                                          - btnChange:
                                              Control: Button
                                              Properties:
                                                FillPortions: =0
                                                Width: =160
                                                Height: =36
                                                Visible: =Coalesce(ThisItem.OwnerConfirmed, false) && Lower(Coalesce(ThisItem.ConfirmedByEmail, "")) = nfMe
                                                Text: ="Change selection"
                                                Appearance: ='ButtonCanvas.Appearance'.Subtle
                                                Layout: ='ButtonCanvas.Layout'.IconBefore
                                                Icon: ="ArrowUndo"
                                                BasePaletteColor: =nfPrimary
                                                OnSelect: |-
                                                  =Patch(
                                                      migration,
                                                      {ID: ThisItem.ID},
                                                      {
                                                          OwnerConfirmed: false,
                                                          PreferredSharePointURL: Blank(),
                                                          ConfirmedBy: Blank(),
                                                          ConfirmedByEmail: Blank(),
                                                          ConfirmedOn: Blank()
                                                      }
                                                  );
                                                  Refresh(migration);
                                                  Notify("Your selection has been reopened — choose again when you're ready.", NotificationType.Information)
                                          - btnConfirmExisting:
                                              Control: Button
                                              Properties:
                                                FillPortions: =0
                                                Width: =168
                                                Height: =40
                                                Visible: =!Coalesce(ThisItem.OwnerConfirmed, false)
                                                DisplayMode: =If((!IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Need) && !IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Type) && !IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Retain)), DisplayMode.Edit, DisplayMode.Disabled)
                                                Text: ="Confirm this site"
                                                Appearance: ='ButtonCanvas.Appearance'.Primary
                                                Layout: ='ButtonCanvas.Layout'.IconBefore
                                                Icon: ="Checkmark"
                                                BasePaletteColor: =nfPrimary
                                                OnSelect: |-
                                                  =Set(varChoice, "Existing");
                                                  Set(varConfirmId, ThisItem.ID);
                                                  Set(varConfirmPath, ThisItem.FileSharePath);
                                                  Set(varTargetUrl, Coalesce(ThisItem.SharePointURL, nfSiteRoot & ThisItem.SecurityGroup));
                                                  Set(varShowConfirm, true)
                                          - btnUseOther:
                                              Control: Button
                                              Properties:
                                                FillPortions: =0
                                                Width: =164
                                                Height: =40
                                                Visible: =!Coalesce(ThisItem.OwnerConfirmed, false)
                                                DisplayMode: =If((!IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Need) && !IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Type) && !IsBlank(LookUp(colAnswers, ID = ThisItem.ID).Retain)), DisplayMode.Edit, DisplayMode.Disabled)
                                                Text: ="Use a different site"
                                                Appearance: ='ButtonCanvas.Appearance'.Secondary
                                                Layout: ='ButtonCanvas.Layout'.IconBefore
                                                Icon: ="Edit"
                                                BasePaletteColor: =nfPrimary
                                                OnSelect: |-
                                                  =Set(varChoice, "Preferred");
                                                  Set(varConfirmId, ThisItem.ID);
                                                  Set(varConfirmPath, ThisItem.FileSharePath);
                                                  Set(varTargetUrl, Coalesce(ThisItem.SharePointURL, nfSiteRoot & ThisItem.SecurityGroup));
                                                  Reset(txtPreferredUrl);
                                                  Set(varShowConfirm, true)

                  # ---------------- Empty state ----------------
                  - conEmpty:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =150
                        Visible: =CountRows(galSites.AllItems) = 0
                        Fill: =nfWhite
                        BorderThickness: =0
                        DropShadow: =DropShadow.Light
                        RadiusTopLeft: =16
                        RadiusTopRight: =16
                        RadiusBottomLeft: =16
                        RadiusBottomRight: =16
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutJustifyContent: =LayoutJustifyContent.Center
                        LayoutGap: =8
                        PaddingLeft: =32
                        PaddingRight: =32
                      Children:
                        - txtEmptyTitle:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =28
                              Text: ="Nothing to confirm right now"
