{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "hideSelection": true,
  "hideColumnHeader": true,
  "rowFormatter": {
    "elmType": "div",
    "style": {
      "display": "flex",
      "width": "calc(100% - 32px)",
      "max-width": "1180px",
      "margin": "10px 16px",
      "background-color": "#FFFFFF",
      "border": "1px solid #EEF0F6",
      "border-radius": "16px",
      "overflow": "hidden",
      "box-sizing": "border-box",
      "box-shadow": "0 1px 2px rgba(15,23,42,0.05), 0 8px 24px rgba(15,23,42,0.07)"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "width": "6px",
          "flex-shrink": "0",
          "background-color": "=if([$Status] == 'New', '#4F46E5', if([$Status] == 'Triaged', '#0EA5E9', if([$Status] == 'In progress', '#F59E0B', if([$Status] == 'Waiting on user', '#EC4899', if([$Status] == 'Resolved', '#16A34A', if([$Status] == 'Closed', '#9CA3AF', '#CBD5E1'))))))"
        }
      },
      {
        "elmType": "div",
        "style": {
          "flex-grow": "1",
          "min-width": "0",
          "padding": "20px 24px 16px"
        },
        "children": [
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap"
            },
            "children": [
              {
                "elmType": "img",
                "attributes": {
                  "src": "='/_layouts/15/userphoto.aspx?size=M&accountname=' + if([$ReportedBy].email == '', [$Author.email], [$ReportedBy].email)"
                },
                "style": {
                  "width": "44px",
                  "height": "44px",
                  "border-radius": "50%",
                  "margin-right": "14px",
                  "object-fit": "cover",
                  "border": "2px solid #E0E7FF",
                  "flex-shrink": "0"
                }
              },
              {
                "elmType": "div",
                "style": {
                  "flex": "1 1 300px",
                  "min-width": "0",
                  "margin-right": "12px"
                },
                "children": [
                  {
                    "elmType": "div",
                    "txtContent": "=if([$Title] == '', '(no summary)', [$Title])",
                    "style": {
                      "font-size": "17px",
                      "font-weight": "700",
                      "color": "#0F172A",
                      "white-space": "nowrap",
                      "overflow": "hidden",
                      "text-overflow": "ellipsis"
                    }
                  },
                  {
                    "elmType": "div",
                    "txtContent": "='HC-' + padStart(toString([$ID]), 4, '0') + '  ·  ' + if([$ReportedBy].title == '', [$Author.title], [$ReportedBy].title) + '  ·  ' + toLocaleDateString([$Created])",
                    "style": {
                      "font-size": "12px",
                      "color": "#64748B",
                      "margin-top": "3px"
                    }
                  }
                ]
              },
              {
                "elmType": "div",
                "style": {
                  "display": "flex",
                  "align-items": "center",
                  "flex-wrap": "wrap",
                  "margin-top": "4px"
                },
                "children": [
                  {
                    "elmType": "span",
                    "txtContent": "=if(toString([$IssueCategory]) == '', 'Uncategorized', [$IssueCategory])",
                    "style": {
                      "padding": "4px 12px",
                      "border-radius": "14px",
                      "font-size": "12px",
                      "font-weight": "600",
                      "background-color": "#F1F5F9",
                      "color": "#334155",
                      "margin-right": "8px",
                      "white-space": "nowrap"
                    }
                  },
                  {
                    "elmType": "span",
                    "txtContent": "=if(toString([$Status]) == '', 'No status', [$Status])",
                    "style": {
                      "padding": "4px 12px",
                      "border-radius": "14px",
                      "font-size": "12px",
                      "font-weight": "700",
                      "white-space": "nowrap",
                      "background-color": "=if([$Status] == 'New', '#EEF2FF', if([$Status] == 'Triaged', '#E0F2FE', if([$Status] == 'In progress', '#FEF3C7', if([$Status] == 'Waiting on user', '#FCE7F3', if([$Status] == 'Resolved', '#DCFCE7', if([$Status] == 'Closed', '#F3F4F6', '#F1F5F9'))))))",
                      "color": "=if([$Status] == 'New', '#4338CA', if([$Status] == 'Triaged', '#0369A1', if([$Status] == 'In progress', '#92400E', if([$Status] == 'Waiting on user', '#9D174D', if([$Status] == 'Resolved', '#15803D', if([$Status] == 'Closed', '#4B5563', '#475569'))))))"
                    }
                  }
                ]
              }
            ]
          },
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "align-items": "center",
              "margin": "18px 0 12px"
            },
            "children": [
              {
                "elmType": "div",
                "style": {
                  "width": "26px",
                  "height": "26px",
                  "border-radius": "8px",
                  "background-color": "#4F46E5",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "center",
                  "margin-right": "10px"
                },
                "children": [
                  {
                    "elmType": "span",
                    "attributes": {
                      "iconName": "Page"
                    },
                    "style": {
                      "font-size": "13px",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "elmType": "span",
                "txtContent": "Request details",
                "style": {
                  "font-size": "13px",
                  "font-weight": "700",
                  "color": "#0F172A"
                }
              },
              {
                "elmType": "div",
                "style": {
                  "flex-grow": "1",
                  "height": "1px",
                  "background-color": "#EEF0F6",
                  "margin-left": "12px"
                }
              }
            ]
          },
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "flex-wrap": "wrap"
            },
            "children": [
              {
                "elmType": "div",
                "style": {
                  "flex": "1 1 220px",
                  "min-width": "180px",
                  "margin": "0 20px 14px 0"
                },
                "children": [
                  {
                    "elmType": "div",
                    "style": {
                      "display": "flex",
                      "align-items": "center",
                      "margin-bottom": "4px"
                    },
                    "children": [
                      {
                        "elmType": "span",
                        "attributes": {
                          "iconName": "FabricFolder"
                        },
                        "style": {
                          "font-size": "12px",
                          "color": "#94A3B8",
                          "margin-right": "6px"
                        }
                      },
                      {
                        "elmType": "span",
                        "txtContent": "File share path",
                        "style": {
                          "font-size": "11px",
                          "font-weight": "600",
                          "letter-spacing": "0.06em",
                          "text-transform": "uppercase",
                          "color": "#64748B"
                        }
                      }
                    ]
                  },
                  {
                    "elmType": "div",
                    "txtContent": "=if(toString([$FileSharePath]) == '', '—', [$FileSharePath])",
                    "style": {
                      "font-size": "13px",
                      "color": "=if(toString([$FileSharePath]) == '', '#94A3B8', '#0F172A')",
                      "word-break": "break-word",
                      "font-family": "Consolas, 'Courier New', monospace"
                    }
                  }
                ]
              },
              {
                "elmType": "div",
                "style": {
                  "flex": "1 1 220px",
                  "min-width": "180px",
                  "margin": "0 20px 14px 0"
                },
                "children": [
                  {
                    "elmType": "div",
                    "style": {
                      "display": "flex",
                      "align-items": "center",
                      "margin-bottom": "4px"
                    },
                    "children": [
                      {
                        "elmType": "span",
                        "attributes": {
                          "iconName": "Tag"
                        },
                        "style": {
                          "font-size": "12px",
                          "color": "#94A3B8",
                          "margin-right": "6px"
                        }
                      },
                      {
                        "elmType": "span",
                        "txtContent": "Issue category",
                        "style": {
                          "font-size": "11px",
                          "font-weight": "600",
                          "letter-spacing": "0.06em",
                          "text-transform": "uppercase",
                          "color": "#64748B"
                        }
                      }
                    ]
                  },
                  {
                    "elmType": "div",
                    "txtContent": "=if(toString([$IssueCategory]) == '', '—', [$IssueCategory])",
                    "style": {
                      "font-size": "14px",
                      "color": "=if(toString([$IssueCategory]) == '', '#94A3B8', '#0F172A')",
                      "word-break": "break-word"
                    }
                  }
                ]
              },
              {
                "elmType": "div",
                "style": {
                  "flex": "1 1 220px",
                  "min-width": "180px",
                  "margin": "0 20px 14px 0",
                  "display": "=if([$IssueCategory] == 'Other', 'block', 'none')"
                },
                "children": [
                  {
                    "elmType": "div",
                    "style": {
                      "display": "flex",
                      "align-items": "center",
                      "margin-bottom": "4px"
                    },
                    "children": [
                      {
                        "elmType": "span",
                        "attributes": {
                          "iconName": "Info"
                        },
                        "style": {
                          "font-size": "12px",
                          "color": "#94A3B8",
                          "margin-right": "6px"
                        }
                      },
                      {
                        "elmType": "span",
                        "txtContent": "Other issue",
                        "style": {
                          "font-size": "11px",
                          "font-weight": "600",
                          "letter-spacing": "0.06em",
                          "text-transform": "uppercase",
                          "color": "#64748B"
                        }
                      }
                    ]
                  },
                  {
                    "elmType": "div",
                    "txtContent": "=if(toString([$OtherIssues]) == '', '—', [$OtherIssues])",
                    "style": {
                      "font-size": "14px",
                      "color": "=if(toString([$OtherIssues]) == '', '#94A3B8', '#0F172A')",
                      "word-break": "break-word"
                    }
                  }
                ]
              }
            ]
          },
          {
            "elmType": "div",
            "style": {
              "display": "=if(toString([$Notes]) == '', 'none', 'block')",
              "margin": "0 0 4px",
              "padding": "12px 14px",
              "background-color": "#F8FAFC",
              "border-left": "3px solid #C7D2FE",
              "border-radius": "8px"
            },
            "children": [
              {
                "elmType": "div",
                "style": {
                  "display": "flex",
                  "align-items": "center",
                  "margin-bottom": "4px"
                },
                "children": [
                  {
                    "elmType": "span",
                    "attributes": {
                      "iconName": "EditNote"
                    },
                    "style": {
                      "font-size": "12px",
                      "color": "#94A3B8",
                      "margin-right": "6px"
                    }
                  },
                  {
                    "elmType": "span",
                    "txtContent": "Notes",
                    "style": {
                      "font-size": "11px",
                      "font-weight": "600",
                      "letter-spacing": "0.06em",
                      "text-transform": "uppercase",
                      "color": "#64748B"
                    }
                  }
                ]
              },
              {
                "elmType": "div",
                "txtContent": "[$Notes]",
                "style": {
                  "font-size": "13px",
                  "color": "#334155",
                  "max-height": "60px",
                  "overflow": "hidden",
                  "word-break": "break-word"
                }
              }
            ]
          },
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "align-items": "center",
              "margin": "18px 0 12px"
            },
            "children": [
              {
                "elmType": "div",
                "style": {
                  "width": "26px",
                  "height": "26px",
                  "border-radius": "8px",
                  "background-color": "#DB2777",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "center",
                  "margin-right": "10px"
                },
                "children": [
                  {
                    "elmType": "span",
                    "attributes": {
                      "iconName": "Settings"
                    },
                    "style": {
                      "font-size": "13px",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "elmType": "span",
                "txtContent": "Admin",
                "style": {
                  "font-size": "13px",
                  "font-weight": "700",
                  "color": "#0F172A"
                }
              },
              {
                "elmType": "div",
                "style": {
                  "flex-grow": "1",
                  "height": "1px",
                  "background-color": "#EEF0F6",
                  "margin-left": "12px"
                }
              }
            ]
          },
          {
            "elmType": "div",
            "style": {
              "padding": "16px 16px 4px",
              "background-color": "#FAFAFF",
              "border": "1px solid #EEF0FB",
              "border-radius": "12px"
            },
            "children": [
              {
                "elmType": "div",
                "style": {
                  "display": "flex",
                  "flex-wrap": "wrap"
                },
                "children": [
                  {
                    "elmType": "div",
                    "style": {
                      "flex": "1 1 220px",
                      "min-width": "180px",
                      "margin": "0 20px 14px 0"
                    },
                    "children": [
                      {
                        "elmType": "div",
                        "style": {
                          "display": "flex",
                          "align-items": "center",
                          "margin-bottom": "4px"
                        },
                        "children": [
                          {
                            "elmType": "span",
                            "attributes": {
                              "iconName": "People"
                            },
                            "style": {
                              "font-size": "12px",
                              "color": "#94A3B8",
                              "margin-right": "6px"
                            }
                          },
                          {
                            "elmType": "span",
                            "txtContent": "Impact",
                            "style": {
                              "font-size": "11px",
                              "font-weight": "600",
                              "letter-spacing": "0.06em",
                              "text-transform": "uppercase",
                              "color": "#64748B"
                            }
                          }
                        ]
                      },
                      {
                        "elmType": "div",
                        "txtContent": "=if(toString([$Impact]) == '', '—', [$Impact])",
                        "style": {
                          "font-size": "14px",
                          "color": "=if(toString([$Impact]) == '', '#94A3B8', '#0F172A')",
                          "word-break": "break-word"
                        }
                      }
                    ]
                  },
                  {
                    "elmType": "div",
                    "style": {
                      "flex": "1 1 220px",
                      "min-width": "180px",
                      "margin": "0 20px 14px 0"
                    },
                    "children": [
                      {
                        "elmType": "div",
                        "style": {
                          "display": "flex",
                          "align-items": "center",
                          "margin-bottom": "4px"
                        },
                        "children": [
                          {
                            "elmType": "span",
                            "attributes": {
                              "iconName": "Contact"
                            },
                            "style": {
                              "font-size": "12px",
                              "color": "#94A3B8",
                              "margin-right": "6px"
                            }
                          },
                          {
                            "elmType": "span",
                            "txtContent": "Assigned to",
                            "style": {
                              "font-size": "11px",
                              "font-weight": "600",
                              "letter-spacing": "0.06em",
                              "text-transform": "uppercase",
                              "color": "#64748B"
                            }
                          }
                        ]
                      },
                      {
                        "elmType": "div",
                        "style": {
                          "display": "flex",
                          "align-items": "center"
                        },
                        "children": [
                          {
                            "elmType": "img",
                            "attributes": {
                              "src": "=if([$AssignedTo].email == '', '', '/_layouts/15/userphoto.aspx?size=S&accountname=' + [$AssignedTo].email)"
                            },
                            "style": {
                              "display": "=if([$AssignedTo].email == '', 'none', 'block')",
                              "width": "24px",
                              "height": "24px",
                              "border-radius": "50%",
                              "margin-right": "8px",
                              "object-fit": "cover"
                            }
                          },
                          {
                            "elmType": "span",
                            "txtContent": "=if([$AssignedTo].title == '', 'Unassigned', [$AssignedTo].title)",
                            "style": {
                              "font-size": "14px",
                              "color": "=if([$AssignedTo].title == '', '#94A3B8', '#0F172A')"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "elmType": "div",
                    "style": {
                      "flex": "1 1 220px",
                      "min-width": "180px",
                      "margin": "0 20px 14px 0"
                    },
                    "children": [
                      {
                        "elmType": "div",
                        "style": {
                          "display": "flex",
                          "align-items": "center",
                          "margin-bottom": "4px"
                        },
                        "children": [
                          {
                            "elmType": "span",
                            "attributes": {
                              "iconName": "SharepointLogo"
                            },
                            "style": {
                              "font-size": "12px",
                              "color": "#94A3B8",
                              "margin-right": "6px"
                            }
                          },
                          {
                            "elmType": "span",
                            "txtContent": "Destination site",
                            "style": {
                              "font-size": "11px",
                              "font-weight": "600",
                              "letter-spacing": "0.06em",
                              "text-transform": "uppercase",
                              "color": "#64748B"
                            }
                          }
                        ]
                      },
                      {
                        "elmType": "a",
                        "txtContent": "=if(toString([$DestinationSite]) == '', '—', if(toString([$DestinationSite].desc) == '', [$DestinationSite], [$DestinationSite].desc))",
                        "attributes": {
                          "href": "[$DestinationSite]",
                          "target": "_blank"
                        },
                        "style": {
                          "font-size": "14px",
                          "color": "=if(toString([$DestinationSite]) == '', '#94A3B8', '#4F46E5')",
                          "text-decoration": "none",
                          "font-weight": "600",
                          "word-break": "break-all",
                          "pointer-events": "=if(toString([$DestinationSite]) == '', 'none', 'auto')"
                        }
                      }
                    ]
                  },
                  {
                    "elmType": "div",
                    "style": {
                      "flex": "1 1 220px",
                      "min-width": "180px",
                      "margin": "0 20px 14px 0"
                    },
                    "children": [
                      {
                        "elmType": "div",
                        "style": {
                          "display": "flex",
                          "align-items": "center",
                          "margin-bottom": "4px"
                        },
                        "children": [
                          {
                            "elmType": "span",
                            "attributes": {
                              "iconName": "Search"
                            },
                            "style": {
                              "font-size": "12px",
                              "color": "#94A3B8",
                              "margin-right": "6px"
                            }
                          },
                          {
                            "elmType": "span",
                            "txtContent": "Root cause",
                            "style": {
                              "font-size": "11px",
                              "font-weight": "600",
                              "letter-spacing": "0.06em",
                              "text-transform": "uppercase",
                              "color": "#64748B"
                            }
                          }
                        ]
                      },
                      {
                        "elmType": "div",
                        "txtContent": "=if(toString([$RootCause]) == '', '—', [$RootCause])",
                        "style": {
                          "font-size": "14px",
                          "color": "=if(toString([$RootCause]) == '', '#94A3B8', '#0F172A')",
                          "word-break": "break-word"
                        }
                      }
                    ]
                  },
                  {
                    "elmType": "div",
                    "style": {
                      "flex": "1 1 220px",
                      "min-width": "180px",
                      "margin": "0 20px 14px 0"
                    },
                    "children": [
                      {
                        "elmType": "div",
                        "style": {
                          "display": "flex",
                          "align-items": "center",
                          "margin-bottom": "4px"
                        },
                        "children": [
                          {
                            "elmType": "span",
                            "attributes": {
                              "iconName": "Calendar"
                            },
                            "style": {
                              "font-size": "12px",
                              "color": "#94A3B8",
                              "margin-right": "6px"
                            }
                          },
                          {
                            "elmType": "span",
                            "txtContent": "Resolved on",
                            "style": {
                              "font-size": "11px",
                              "font-weight": "600",
                              "letter-spacing": "0.06em",
                              "text-transform": "uppercase",
                              "color": "#64748B"
                            }
                          }
                        ]
                      },
                      {
                        "elmType": "div",
                        "txtContent": "=if(toString([$ResolvedOn]) == '', '—', toLocaleDateString([$ResolvedOn]))",
                        "style": {
                          "font-size": "14px",
                          "color": "=if(toString([$ResolvedOn]) == '', '#94A3B8', '#0F172A')"
                        }
                      }
                    ]
                  },
                  {
                    "elmType": "div",
                    "style": {
                      "flex": "1 1 220px",
                      "min-width": "180px",
                      "margin": "0 20px 14px 0"
                    },
                    "children": [
                      {
                        "elmType": "div",
                        "style": {
                          "display": "flex",
                          "align-items": "center",
                          "margin-bottom": "4px"
                        },
                        "children": [
                          {
                            "elmType": "span",
                            "attributes": {
                              "iconName": "Sync"
                            },
                            "style": {
                              "font-size": "12px",
                              "color": "#94A3B8",
                              "margin-right": "6px"
                            }
                          },
                          {
                            "elmType": "span",
                            "txtContent": "Re-migration",
                            "style": {
                              "font-size": "11px",
                              "font-weight": "600",
                              "letter-spacing": "0.06em",
                              "text-transform": "uppercase",
                              "color": "#64748B"
                            }
                          }
                        ]
                      },
                      {
                        "elmType": "span",
                        "txtContent": "=if([$RequiresRemigration] == true, 'Required', 'Not required')",
                        "style": {
                          "display": "inline-block",
                          "padding": "3px 10px",
                          "border-radius": "12px",
                          "font-size": "12px",
                          "font-weight": "600",
                          "background-color": "=if([$RequiresRemigration] == true, '#FEE2E2', '#ECFDF5')",
                          "color": "=if([$RequiresRemigration] == true, '#B91C1C', '#047857')"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "elmType": "div",
                "style": {
                  "display": "=if(toString([$Resolution]) == '', 'none', 'block')",
                  "margin-bottom": "12px"
                },
                "children": [
                  {
                    "elmType": "div",
                    "style": {
                      "display": "flex",
                      "align-items": "center",
                      "margin-bottom": "4px"
                    },
                    "children": [
                      {
                        "elmType": "span",
                        "attributes": {
                          "iconName": "Completed"
                        },
                        "style": {
                          "font-size": "12px",
                          "color": "#94A3B8",
                          "margin-right": "6px"
                        }
                      },
                      {
                        "elmType": "span",
                        "txtContent": "Resolution",
                        "style": {
                          "font-size": "11px",
                          "font-weight": "600",
                          "letter-spacing": "0.06em",
                          "text-transform": "uppercase",
                          "color": "#64748B"
                        }
                      }
                    ]
                  },
                  {
                    "elmType": "div",
                    "txtContent": "[$Resolution]",
                    "style": {
                      "font-size": "13px",
                      "color": "#334155",
                      "max-height": "60px",
                      "overflow": "hidden",
                      "word-break": "break-word"
                    }
                  }
                ]
              }
            ]
          },
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "align-items": "center",
              "margin-top": "14px"
            },
            "children": [
              {
                "elmType": "span",
                "txtContent": "=if(([$Status] != 'Resolved' && [$Status] != 'Closed'), 'Open for ' + toString(floor((Number(@now) - Number([$Created])) / 86400000)) + ' day(s)', 'Closed out')",
                "style": {
                  "font-size": "12px",
                  "color": "#64748B",
                  "flex-grow": "1"
                }
              },
              {
                "elmType": "button",
                "customRowAction": {
                  "action": "defaultClick"
                },
                "txtContent": "View",
                "style": {
                  "border": "1px solid #E2E8F0",
                  "background-color": "#FFFFFF",
                  "color": "#334155",
                  "padding": "7px 16px",
                  "border-radius": "10px",
                  "font-size": "13px",
                  "font-weight": "600",
                  "cursor": "pointer",
                  "margin-right": "8px"
                }
              },
              {
                "elmType": "button",
                "customRowAction": {
                  "action": "editProps"
                },
                "style": {
                  "border": "none",
                  "background-color": "#4F46E5",
                  "color": "#FFFFFF",
                  "padding": "8px 16px",
                  "border-radius": "10px",
                  "font-size": "13px",
                  "font-weight": "600",
                  "cursor": "pointer",
                  "display": "flex",
                  "align-items": "center"
                },
                "children": [
                  {
                    "elmType": "span",
                    "attributes": {
                      "iconName": "Edit"
                    },
                    "style": {
                      "margin-right": "6px",
                      "font-size": "13px"
                    }
                  },
                  {
                    "elmType": "span",
                    "txtContent": "Update"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "groupProps": {
    "hideFooter": true,
    "headerFormatter": {
      "elmType": "div",
      "style": {
        "display": "flex",
        "align-items": "center",
        "width": "calc(100% - 32px)",
        "max-width": "1180px",
        "margin": "22px 16px 4px",
        "padding": "10px 16px",
        "border-radius": "12px",
        "background-color": "=if(@group.fieldData.displayValue == 'New', '#EEF2FF', if(@group.fieldData.displayValue == 'Triaged', '#E0F2FE', if(@group.fieldData.displayValue == 'In progress', '#FEF3C7', if(@group.fieldData.displayValue == 'Waiting on user', '#FCE7F3', if(@group.fieldData.displayValue == 'Resolved', '#DCFCE7', if(@group.fieldData.displayValue == 'Closed', '#F3F4F6', '#F1F5F9'))))))"
      },
      "children": [
        {
          "elmType": "span",
          "style": {
            "width": "10px",
            "height": "10px",
            "border-radius": "50%",
            "margin-right": "10px",
            "background-color": "=if(@group.fieldData.displayValue == 'New', '#4F46E5', if(@group.fieldData.displayValue == 'Triaged', '#0EA5E9', if(@group.fieldData.displayValue == 'In progress', '#F59E0B', if(@group.fieldData.displayValue == 'Waiting on user', '#EC4899', if(@group.fieldData.displayValue == 'Resolved', '#16A34A', if(@group.fieldData.displayValue == 'Closed', '#9CA3AF', '#94A3B8'))))))"
          }
        },
        {
          "elmType": "span",
          "txtContent": "=if(toString(@group.fieldData.displayValue) == '', 'No status', @group.fieldData.displayValue)",
          "style": {
            "font-size": "15px",
            "font-weight": "700",
            "color": "=if(@group.fieldData.displayValue == 'New', '#4338CA', if(@group.fieldData.displayValue == 'Triaged', '#0369A1', if(@group.fieldData.displayValue == 'In progress', '#92400E', if(@group.fieldData.displayValue == 'Waiting on user', '#9D174D', if(@group.fieldData.displayValue == 'Resolved', '#15803D', if(@group.fieldData.displayValue == 'Closed', '#4B5563', '#334155'))))))",
            "flex-grow": "1"
          }
        },
        {
          "elmType": "span",
          "txtContent": "=toString(@group.count) + if(@group.count == 1, ' request', ' requests')",
          "style": {
            "font-size": "12px",
            "font-weight": "600",
            "color": "=if(@group.fieldData.displayValue == 'New', '#4338CA', if(@group.fieldData.displayValue == 'Triaged', '#0369A1', if(@group.fieldData.displayValue == 'In progress', '#92400E', if(@group.fieldData.displayValue == 'Waiting on user', '#9D174D', if(@group.fieldData.displayValue == 'Resolved', '#15803D', if(@group.fieldData.displayValue == 'Closed', '#4B5563', '#334155'))))))",
            "background-color": "#FFFFFF",
            "padding": "3px 10px",
            "border-radius": "12px"
          }
        }
      ]
    }
  }
}
