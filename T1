# =====================================================================
#  Migration Hub - 3 screens, Source Code schema (pa.yaml v3)
#    scrMigration      owner view: confirm / override destination site
#    scrAdminWaves     admin: open / close waves for owners
#    scrAdminProgress  admin: metrics + status pipeline
#
#  Paste: select "App" at the top of the tree view, Ctrl+V (creates all 3
#  screens). Delete or rename any older scrMigration first.
#  Fallback: create 3 blank screens and paste each screen's Children block.
#
#  Prereqs: data sources "migration" + "WaveSettings"; App.Formulas.txt pasted.
#  New list WaveSettings = Title, WaveNumber (single line text), IsActive (Yes/No).
# =====================================================================
Screens:

  # ===================================================================
  #  OWNER SCREEN
  # ===================================================================
  scrMigration:
    Properties:
      Fill: =nfPageBg
    Children:
      - conPage:
          Control: GroupContainer
          Variant: AutoLayout
          Properties:
            X: =0
            Y: =0
            Width: =Parent.Width
            Height: =Parent.Height
            Fill: =nfPageBg
            BorderThickness: =0
            LayoutDirection: =LayoutDirection.Vertical
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutJustifyContent: =LayoutJustifyContent.Start
            LayoutGap: =0
          Children:

            # ---------------- Top bar ----------------
            - conTopBar:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =0
                  Height: =64
                  Fill: =nfWhite
                  BorderThickness: =0
                  DropShadow: =DropShadow.Light
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =16
                  PaddingLeft: =24
                  PaddingRight: =24
                Children:
                  - conBrand:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =1
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =12
                      Children:
                        - imgLogo:
                            Control: Image
                            Properties:
                              FillPortions: =0
                              Width: =36
                              Height: =36
                              ImagePosition: =ImagePosition.Fit
                              Image: |-
                                ="data:image/svg+xml;utf8," & EncodeUrl("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 36'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#4F46E5'/><stop offset='1' stop-color='#DB2777'/></linearGradient></defs><rect width='36' height='36' rx='10' fill='url(#g)'/><path d='M9 12.5h7l2 2.5h9v9.5H9z' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linejoin='round'/><path d='M18 23v-5.5M15.5 20l2.5-2.5 2.5 2.5' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>")
                        - conBrandText:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =0
                            Children:
                              - txtBrand:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =20
                                    Text: ="Migration Hub"
                                    Size: =15
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfInk
                                    Wrap: =false
                              - txtBrandSub:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =16
                                    Text: ="File share migration · owner confirmation"
                                    Size: =11
                                    FontColor: =nfMuted
                                    Wrap: =false
                  - btnAdmin:
                      Control: Button
                      Properties:
                        FillPortions: =0
                        Width: =110
                        Height: =36
                        Visible: =nfIsAdmin
                        Text: ="Admin"
                        Appearance: ='ButtonCanvas.Appearance'.Secondary
                        Layout: ='ButtonCanvas.Layout'.IconBefore
                        Icon: ="Settings"
                        BasePaletteColor: =nfPrimary
                        OnSelect: =Navigate(scrAdminWaves)
                  - conUserChip:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Width: =240
                        Height: =44
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.End
                        LayoutGap: =10
                      Children:
                        - conChipText:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =0
                            Children:
                              - txtChipName:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =18
                                    Text: =User().FullName
                                    Size: =13
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfInk
                                    Align: ='TextCanvas.Align'.End
                                    Wrap: =false
                              - txtChipEmail:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =16
                                    Text: =User().Email
                                    Size: =11
                                    FontColor: =nfMuted
                                    Align: ='TextCanvas.Align'.End
                                    Wrap: =false
                        - conAvatar:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =0
                              Width: =36
                              Height: =36
                              Fill: =nfPrimary
                              BorderThickness: =0
                              RadiusTopLeft: =18
                              RadiusTopRight: =18
                              RadiusBottomLeft: =18
                              RadiusBottomRight: =18
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                            Children:
                              - txtInitials:
                                  Control: Text
                                  Properties:
                                    FillPortions: =1
                                    Text: =Upper(Left(User().FullName, 1) & Left(Last(Split(User().FullName, " ")).Value, 1))
                                    Size: =13
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfWhite
                                    Align: ='TextCanvas.Align'.Center
                                    VerticalAlign: =VerticalAlign.Middle
                                    Wrap: =false

            # ---------------- Body ----------------
            - conBody:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =1
                  Fill: =RGBA(0, 0, 0, 0)
                  BorderThickness: =0
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =12
                  PaddingLeft: =48
                  PaddingRight: =48
                  PaddingTop: =28
                  PaddingBottom: =24
                Children:
                  - conHero:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =72
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =16
                      Children:
                        - conHeroText:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =4
                            Children:
                              - txtTitle:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =36
                                    Text: ="Destination site confirmation"
                                    Size: =26
                                    Weight: ='TextCanvas.Weight'.Bold
                                    FontColor: =nfInk
                                    Wrap: =false
                              - txtSubtitle:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =22
                                    Text: ="Hi " & User().FullName & " — review each file share you own and confirm where it should land in SharePoint."
                                    Size: =14
                                    FontColor: =nfMuted
                                    Wrap: =false
                        - pillOpenWaves:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =0
                              Width: =260
                              Height: =32
                              AlignInContainer: =AlignInContainer.Center
                              Fill: =RGBA(79, 70, 229, 0.12)
                              BorderThickness: =0
                              RadiusTopLeft: =16
                              RadiusTopRight: =16
                              RadiusBottomLeft: =16
                              RadiusBottomRight: =16
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                            Children:
                              - txtOpenWaves:
                                  Control: Text
                                  Properties:
                                    FillPortions: =1
                                    Text: ="Open now · " & nfActiveWaveText
                                    Size: =12
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfPrimary
                                    Align: ='TextCanvas.Align'.Center
                                    VerticalAlign: =VerticalAlign.Middle
                                    Wrap: =false
                  - conSectionHead:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =32
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =12
                      Children:
                        - txtSectionTitle:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Width: =180
                              Height: =32
                              Text: ="Your file shares"
                              Size: =20
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfInk
                              VerticalAlign: =VerticalAlign.Middle
                              Wrap: =false
                        - pillCount:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =0
                              Width: =140
                              Height: =26
                              AlignInContainer: =AlignInContainer.Center
                              Fill: =RGBA(79, 70, 229, 0.12)
                              BorderThickness: =0
                              RadiusTopLeft: =13
                              RadiusTopRight: =13
                              RadiusBottomLeft: =13
                              RadiusBottomRight: =13
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                            Children:
                              - txtCount:
                                  Control: Text
                                  Properties:
                                    FillPortions: =1
                                    Text: =CountRows(galSites.AllItems) & If(CountRows(galSites.AllItems) = 1, " file share", " file shares")
                                    Size: =12
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfPrimary
                                    Align: ='TextCanvas.Align'.Center
                                    VerticalAlign: =VerticalAlign.Middle
                                    Wrap: =false
                  - txtSectionHint:
                      Control: Text
                      Properties:
                        FillPortions: =0
                        Height: =22
                        Text: ="Confirm the auto-created site for each share, or point it to an existing site you own. Once one owner submits, the choice is locked for the other owners."
                        Size: =13
                        FontColor: =nfMuted
                        Wrap: =false

                  # ---------------- Gallery of owned shares ----------------
                  - galSites:
                      Control: Gallery
                      Variant: Vertical
                      Properties:
                        FillPortions: =1
                        Items: =nfMySites
                        TemplateSize: =200
                        TemplatePadding: =0
                        ShowScrollbar: =false
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LoadingSpinner: =LoadingSpinner.Data
                        LoadingSpinnerColor: =nfPrimary
                      Children:
                        - conCard:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              X: =4
                              Y: =6
                              Width: =Parent.TemplateWidth - 8
                              Height: =Parent.TemplateHeight - 12
                              Fill: =nfWhite
                              BorderThickness: =0
                              DropShadow: =DropShadow.Light
                              RadiusTopLeft: =16
                              RadiusTopRight: =16
                              RadiusBottomLeft: =16
                              RadiusBottomRight: =16
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Start
                              LayoutGap: =0
                            Children:
                              - conAccent:
                                  Control: GroupContainer
                                  Variant: ManualLayout
                                  Properties:
                                    FillPortions: =0
                                    Width: =8
                                    Fill: =If(ThisItem.OwnerConfirmed, nfSuccess, nfWarning)
                                    BorderThickness: =0
                                    RadiusTopLeft: =16
                                    RadiusBottomLeft: =16
                                    RadiusTopRight: =0
                                    RadiusBottomRight: =0
                              - conInfo:
                                  Control: GroupContainer
                                  Variant: AutoLayout
                                  Properties:
                                    FillPortions: =1
                                    Fill: =RGBA(0, 0, 0, 0)
                                    BorderThickness: =0
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutAlignItems: =LayoutAlignItems.Stretch
                                    LayoutJustifyContent: =LayoutJustifyContent.Center
                                    LayoutGap: =8
                                    PaddingLeft: =24
                                    PaddingRight: =16
                                    PaddingTop: =16
                                    PaddingBottom: =16
                                  Children:
                                    - txtPath:
                                        Control: Text
                                        Properties:
                                          FillPortions: =0
                                          Height: =28
                                          Text: =ThisItem.FileSharePath
                                          Size: =17
                                          Weight: ='TextCanvas.Weight'.Semibold
                                          FontColor: =nfInk
                                          Wrap: =false
                                    - conPills:
                                        Control: GroupContainer
                                        Variant: AutoLayout
                                        Properties:
                                          FillPortions: =0
                                          Height: =28
                                          Fill: =RGBA(0, 0, 0, 0)
                                          BorderThickness: =0
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutAlignItems: =LayoutAlignItems.Stretch
                                          LayoutJustifyContent: =LayoutJustifyContent.Start
                                          LayoutGap: =8
                                        Children:
                                          - pillWave:
                                              Control: GroupContainer
                                              Variant: AutoLayout
                                              Properties:
                                                FillPortions: =0
                                                Width: =96
                                                Fill: =RGBA(79, 70, 229, 0.12)
                                                BorderThickness: =0
                                                RadiusTopLeft: =14
                                                RadiusTopRight: =14
                                                RadiusBottomLeft: =14
                                                RadiusBottomRight: =14
                                                LayoutDirection: =LayoutDirection.Horizontal
                                                LayoutAlignItems: =LayoutAlignItems.Stretch
                                                LayoutJustifyContent: =LayoutJustifyContent.Center
                                              Children:
                                                - txtWave:
                                                    Control: Text
                                                    Properties:
                                                      FillPortions: =1
                                                      Text: =ThisItem.Wave
                                                      Size: =12
                                                      Weight: ='TextCanvas.Weight'.Semibold
                                                      FontColor: =nfPrimary
                                                      Align: ='TextCanvas.Align'.Center
                                                      VerticalAlign: =VerticalAlign.Middle
                                                      Wrap: =false
                                          - pillStatus:
                                              Control: GroupContainer
                                              Variant: AutoLayout
                                              Properties:
                                                FillPortions: =0
                                                Width: =236
                                                Fill: =If(ThisItem.OwnerConfirmed, RGBA(22, 163, 74, 0.14), RGBA(245, 158, 11, 0.18))
                                                BorderThickness: =0
                                                RadiusTopLeft: =14
                                                RadiusTopRight: =14
                                                RadiusBottomLeft: =14
                                                RadiusBottomRight: =14
                                                LayoutDirection: =LayoutDirection.Horizontal
                                                LayoutAlignItems: =LayoutAlignItems.Stretch
                                                LayoutJustifyContent: =LayoutJustifyContent.Center
                                              Children:
                                                - txtStatus:
                                                    Control: Text
                                                    Properties:
                                                      FillPortions: =1
                                                      Text: |-
                                                        =If(
                                                            ThisItem.OwnerConfirmed,
                                                            If(
                                                                Lower(Coalesce(ThisItem.ConfirmedByEmail, "")) = nfMe,
                                                                "Confirmed by you",
                                                                "Confirmed by " & ThisItem.ConfirmedBy
                                                            ),
                                                            "Awaiting your confirmation"
                                                        )
                                                      Size: =12
                                                      Weight: ='TextCanvas.Weight'.Semibold
                                                      FontColor: =If(ThisItem.OwnerConfirmed, nfSuccessText, nfWarningText)
                                                      Align: ='TextCanvas.Align'.Center
                                                      VerticalAlign: =VerticalAlign.Middle
                                                      Wrap: =false
                                          - txtOwners:
                                              Control: Text
                                              Properties:
                                                FillPortions: =1
                                                Text: ="Owners · " & Concat(ThisItem.Owners, DisplayName, ", ")
                                                Size: =12
                                                FontColor: =nfMuted
                                                VerticalAlign: =VerticalAlign.Middle
                                                Wrap: =false
                                    - txtDestLabel:
                                        Control: Text
                                        Properties:
                                          FillPortions: =0
                                          Height: =16
                                          Text: ="DESTINATION SITE"
                                          Size: =11
                                          Weight: ='TextCanvas.Weight'.Semibold
                                          FontColor: =nfMuted
                                          Wrap: =false
                                    - txtDestUrl:
                                        Control: Text
                                        Properties:
                                          FillPortions: =0
                                          Height: =22
                                          Text: =Coalesce(ThisItem.PreferredSharePointURL, ThisItem.SharePointURL, nfSiteRoot & ThisItem.SecurityGroup)
                                          Size: =14
                                          Weight: ='TextCanvas.Weight'.Semibold
                                          FontColor: =nfPrimary
                                          Wrap: =false
                                    - txtDestNote:
                                        Control: Text
                                        Properties:
                                          FillPortions: =0
                                          Height: =18
                                          Text: |-
                                            =If(
                                                !IsBlank(ThisItem.PreferredSharePointURL),
                                                "Owner-provided site · replaces the auto-created " & ThisItem.SharePointURL,
                                                "Auto-created site · security group " & ThisItem.SecurityGroup
                                            )
                                          Size: =12
                                          FontColor: =nfMuted
                                          Wrap: =false
                              - conActions:
                                  Control: GroupContainer
                                  Variant: AutoLayout
                                  Properties:
                                    FillPortions: =0
                                    Width: =380
                                    Fill: =RGBA(0, 0, 0, 0)
                                    BorderThickness: =0
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutAlignItems: =LayoutAlignItems.Stretch
                                    LayoutJustifyContent: =LayoutJustifyContent.Center
                                    LayoutGap: =10
                                    PaddingLeft: =8
                                    PaddingRight: =24
                                    PaddingTop: =16
                                    PaddingBottom: =16
                                  Children:
                                    - conActionButtons:
                                        Control: GroupContainer
                                        Variant: AutoLayout
                                        Properties:
                                          FillPortions: =0
                                          Height: =40
                                          Visible: =!Coalesce(ThisItem.OwnerConfirmed, false)
                                          Fill: =RGBA(0, 0, 0, 0)
                                          BorderThickness: =0
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutAlignItems: =LayoutAlignItems.Stretch
                                          LayoutJustifyContent: =LayoutJustifyContent.Start
                                          LayoutGap: =10
                                        Children:
                                          - btnConfirmExisting:
                                              Control: Button
                                              Properties:
                                                FillPortions: =0
                                                Width: =168
                                                Text: ="Confirm this site"
                                                Appearance: ='ButtonCanvas.Appearance'.Primary
                                                Layout: ='ButtonCanvas.Layout'.IconBefore
                                                Icon: ="Checkmark"
                                                BasePaletteColor: =nfPrimary
                                                OnSelect: |-
                                                  =Set(varChoice, "Existing");
                                                  Set(varConfirmId, ThisItem.ID);
                                                  Set(varConfirmPath, ThisItem.FileSharePath);
                                                  Set(varTargetUrl, Coalesce(ThisItem.SharePointURL, nfSiteRoot & ThisItem.SecurityGroup));
                                                  Set(varShowConfirm, true)
                                          - btnUseOther:
                                              Control: Button
                                              Properties:
                                                FillPortions: =0
                                                Width: =164
                                                Text: ="Use a different site"
                                                Appearance: ='ButtonCanvas.Appearance'.Secondary
                                                Layout: ='ButtonCanvas.Layout'.IconBefore
                                                Icon: ="Edit"
                                                BasePaletteColor: =nfPrimary
                                                OnSelect: |-
                                                  =Set(varChoice, "Preferred");
                                                  Set(varConfirmId, ThisItem.ID);
                                                  Set(varConfirmPath, ThisItem.FileSharePath);
                                                  Set(varTargetUrl, Coalesce(ThisItem.SharePointURL, nfSiteRoot & ThisItem.SecurityGroup));
                                                  Reset(txtPreferredUrl);
                                                  Set(varShowConfirm, true)
                                    - txtConfirmedMsg:
                                        Control: Text
                                        Properties:
                                          FillPortions: =0
                                          Height: =64
                                          Visible: =Coalesce(ThisItem.OwnerConfirmed, false)
                                          Text: |-
                                            =If(
                                                Lower(Coalesce(ThisItem.ConfirmedByEmail, "")) = nfMe,
                                                "You confirmed this selection on " & Text(ThisItem.ConfirmedOn, "mmm d, yyyy") & ".",
                                                "Selection has been submitted by the other owner (" & ThisItem.ConfirmedBy & ") on the app on " & Text(ThisItem.ConfirmedOn, "mmm d, yyyy") & "."
                                            )
                                          Size: =13
                                          FontColor: =nfInk
                                          Wrap: =true
                                    - btnChange:
                                        Control: Button
                                        Properties:
                                          FillPortions: =0
                                          Width: =160
                                          Height: =32
                                          AlignInContainer: =AlignInContainer.Start
                                          Visible: =Coalesce(ThisItem.OwnerConfirmed, false) && Lower(Coalesce(ThisItem.ConfirmedByEmail, "")) = nfMe
                                          Text: ="Change selection"
                                          Appearance: ='ButtonCanvas.Appearance'.Subtle
                                          Layout: ='ButtonCanvas.Layout'.IconBefore
                                          Icon: ="ArrowUndo"
                                          BasePaletteColor: =nfPrimary
                                          OnSelect: |-
                                            =Patch(
                                                migration,
                                                {ID: ThisItem.ID},
                                                {
                                                    OwnerConfirmed: false,
                                                    PreferredSharePointURL: Blank(),
                                                    ConfirmedBy: Blank(),
                                                    ConfirmedByEmail: Blank(),
                                                    ConfirmedOn: Blank()
                                                }
                                            );
                                            Refresh(migration);
                                            Notify("Your selection has been reopened — choose again when you're ready.", NotificationType.Information)
                                    - btnOpenSite:
                                        Control: Button
                                        Properties:
                                          FillPortions: =0
                                          Width: =130
                                          Height: =32
                                          AlignInContainer: =AlignInContainer.Start
                                          Text: ="Open site"
                                          Appearance: ='ButtonCanvas.Appearance'.Subtle
                                          Layout: ='ButtonCanvas.Layout'.IconBefore
                                          Icon: ="Open"
                                          BasePaletteColor: =nfPrimary
                                          OnSelect: =Launch(Coalesce(ThisItem.PreferredSharePointURL, ThisItem.SharePointURL, nfSiteRoot & ThisItem.SecurityGroup))

                  # ---------------- Empty state ----------------
                  - conEmpty:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =150
                        Visible: =CountRows(galSites.AllItems) = 0
                        Fill: =nfWhite
                        BorderThickness: =0
                        DropShadow: =DropShadow.Light
                        RadiusTopLeft: =16
                        RadiusTopRight: =16
                        RadiusBottomLeft: =16
                        RadiusBottomRight: =16
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutJustifyContent: =LayoutJustifyContent.Center
                        LayoutGap: =8
                        PaddingLeft: =32
                        PaddingRight: =32
                      Children:
                        - txtEmptyTitle:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =28
                              Text: ="Nothing to confirm right now"
                              Size: =18
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfInk
                              Wrap: =false
                        - txtEmptyBody:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =44
                              Text: ="Your file shares aren't in an open wave yet, or you're not listed as an owner. You'll get an email when your wave opens — if you think something's missing, contact the migration team."
                              Size: =13
                              FontColor: =nfMuted
                              Wrap: =true

      # ---------------- Confirmation dialog (overlay) ----------------
      - conScrim:
          Control: GroupContainer
          Variant: ManualLayout
          Properties:
            X: =0
            Y: =0
            Width: =Parent.Width
            Height: =Parent.Height
            Visible: =varShowConfirm
            Fill: =RGBA(17, 24, 39, 0.55)
            BorderThickness: =0
          Children:
            - conDialog:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  X: =(Parent.Width - Self.Width) / 2
                  Y: =(Parent.Height - Self.Height) / 2
                  Width: =Min(560, Parent.Width - 32)
                  Height: =500
                  Fill: =nfWhite
                  BorderThickness: =0
                  DropShadow: =DropShadow.Bold
                  RadiusTopLeft: =20
                  RadiusTopRight: =20
                  RadiusBottomLeft: =20
                  RadiusBottomRight: =20
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =0
                Children:
                  - conDialogStrip:
                      Control: GroupContainer
                      Variant: ManualLayout
                      Properties:
                        FillPortions: =0
                        Height: =8
                        Fill: =If(varChoice = "Preferred", nfAccent, nfPrimary)
                        BorderThickness: =0
                        RadiusTopLeft: =20
                        RadiusTopRight: =20
                        RadiusBottomLeft: =0
                        RadiusBottomRight: =0
                  - conDialogBody:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =1
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =8
                        PaddingLeft: =36
                        PaddingRight: =36
                        PaddingTop: =28
