                                    LayoutGap: =8
                                    PaddingLeft: =28
                                    PaddingRight: =28
                                    PaddingTop: =22
                                    PaddingBottom: =12
                                  Children:
                                    - txtWaveCardTitle:
                                        Control: Text
                                        Properties:
                                          FillPortions: =0
                                          Height: =26
                                          Text: ="By wave"
                                          Size: =18
                                          Weight: ='TextCanvas.Weight'.Semibold
                                          FontColor: =nfInk
                                          Wrap: =false
                                    - galWaveStats:
                                        Control: Gallery
                                        Variant: Vertical
                                        Properties:
                                          FillPortions: =1
                                          Items: =Sort(Distinct(colMig, Wave), Value)
                                          TemplateSize: =44
                                          TemplatePadding: =0
                                          ShowScrollbar: =false
                                          Fill: =RGBA(0, 0, 0, 0)
                                          BorderThickness: =0
                                        Children:
                                          - conWaveStatRow:
                                              Control: GroupContainer
                                              Variant: AutoLayout
                                              Properties:
                                                X: =0
                                                Y: =0
                                                Width: =Parent.TemplateWidth
                                                Height: =Parent.TemplateHeight
                                                Fill: =RGBA(0, 0, 0, 0)
                                                BorderThickness: =0
                                                LayoutDirection: =LayoutDirection.Horizontal
                                                LayoutAlignItems: =LayoutAlignItems.Center
                                                LayoutJustifyContent: =LayoutJustifyContent.Start
                                                LayoutGap: =12
                                              Children:
                                                - txtWsName:
                                                    Control: Text
                                                    Properties:
                                                      FillPortions: =0
                                                      Width: =80
                                                      Height: =24
                                                      Text: =ThisItem.Value
                                                      Size: =13
                                                      Weight: ='TextCanvas.Weight'.Semibold
                                                      FontColor: =nfInk
                                                      VerticalAlign: =VerticalAlign.Middle
                                                      Wrap: =false
                                                - pillWsState:
                                                    Control: GroupContainer
                                                    Variant: AutoLayout
                                                    Properties:
                                                      FillPortions: =0
                                                      Width: =96
                                                      Height: =24
                                                      Fill: =If(nfShowAllWaves || !IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), RGBA(22, 163, 74, 0.14), RGBA(107, 114, 128, 0.16))
                                                      BorderThickness: =0
                                                      RadiusTopLeft: =12
                                                      RadiusTopRight: =12
                                                      RadiusBottomLeft: =12
                                                      RadiusBottomRight: =12
                                                      LayoutDirection: =LayoutDirection.Horizontal
                                                      LayoutAlignItems: =LayoutAlignItems.Stretch
                                                      LayoutJustifyContent: =LayoutJustifyContent.Center
                                                    Children:
                                                      - txtWsState:
                                                          Control: Text
                                                          Properties:
                                                            FillPortions: =1
                                                            Text: =If(nfShowAllWaves || !IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), "Active", "Inactive")
                                                            Size: =11
                                                            Weight: ='TextCanvas.Weight'.Semibold
                                                            FontColor: =If(nfShowAllWaves || !IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), nfSuccessText, nfMuted)
                                                            Align: ='TextCanvas.Align'.Center
                                                            VerticalAlign: =VerticalAlign.Middle
                                                            Wrap: =false
                                                - txtWsStats:
                                                    Control: Text
                                                    Properties:
                                                      FillPortions: =1
                                                      Height: =24
                                                      Text: |-
                                                        =With(
                                                            {_rows: Filter(colMig, Wave = ThisItem.Value)},
                                                            CountRows(_rows) & " shares · "
                                                            & CountRows(Filter(_rows, OwnerConfirmed = true)) & " confirmed · "
                                                            & CountRows(Filter(_rows, MigrationStatus.Value = "Site Migrated")) & " migrated"
                                                        )
                                                      Size: =12
                                                      FontColor: =nfMuted
                                                      VerticalAlign: =VerticalAlign.Middle
                                                      Wrap: =false
