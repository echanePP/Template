            Y: =0
            Width: =Parent.Width
            Height: =Parent.Height
            Visible: =varWavePickerOpen
            Fill: =RGBA(17, 24, 39, 0.25)
            BorderThickness: =0
          Children:
            - conWavePickerPanel:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  X: =Parent.Width - 48 - 232 - Self.Width
                  Y: =188
                  Width: =340
                  Height: =Min(440, Parent.Height - 220)
                  Fill: =nfWhite
                  BorderThickness: =0
                  DropShadow: =DropShadow.Bold
                  RadiusTopLeft: =16
                  RadiusTopRight: =16
                  RadiusBottomLeft: =16
                  RadiusBottomRight: =16
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =8
                  PaddingLeft: =16
                  PaddingRight: =16
                  PaddingTop: =16
                  PaddingBottom: =12
                Children:
                  - conWavePickerHead:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =28
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =8
                      Children:
                        - txtWavePickerTitle:
                            Control: Text
                            Properties:
                              FillPortions: =1
                              Height: =28
                              Text: ="Filter by wave · " & CountRows(Distinct(colMig, Wave)) & " waves"
                              Size: =13
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfInk
                              VerticalAlign: =VerticalAlign.Middle
                              Wrap: =false
                        - btnWavePickerClose:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =36
                              Height: =28
                              Text: =""
                              Appearance: ='ButtonCanvas.Appearance'.Subtle
                              Layout: ='ButtonCanvas.Layout'.IconOnly
                              Icon: ="Dismiss"
                              BasePaletteColor: =nfPrimary
                              OnSelect: =Set(varWavePickerOpen, false)
                  - txtWaveSearch:
                      Control: TextInput
                      Properties:
                        FillPortions: =0
                        Height: =36
                        Value: =""
                        Placeholder: ="Search waves…"
                  - btnWavePickAll:
                      Control: Button
                      Properties:
                        FillPortions: =0
                        Height: =36
                        Text: ="All waves"
                        Appearance: =If(varWaveFilter = "", 'ButtonCanvas.Appearance'.Primary, 'ButtonCanvas.Appearance'.Subtle)
                        Layout: ='ButtonCanvas.Layout'.IconBefore
                        Icon: =If(varWaveFilter = "", "Checkmark", "Filter")
                        BasePaletteColor: =nfPrimary
                        OnSelect: |-
                          =Set(varWaveFilter, "");
                          ClearCollect(colMigF, colMig);
                          Set(varWavePickerOpen, false)
                  - galWavePicker:
                      Control: Gallery
                      Variant: Vertical
                      Properties:
                        FillPortions: =1
                        Items: =Filter(Sort(Distinct(colMig, Wave), Value), IsBlank(txtWaveSearch.Value) || txtWaveSearch.Value in Value)
                        TemplateSize: =40
                        TemplatePadding: =0
                        ShowScrollbar: =true
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                      Children:
                        - btnWavePick:
                            Control: Button
                            Properties:
                              X: =0
                              Y: =2
                              Width: =Parent.TemplateWidth - 4
                              Height: =36
                              Text: =ThisItem.Value
                              Appearance: =If(varWaveFilter = ThisItem.Value, 'ButtonCanvas.Appearance'.Primary, 'ButtonCanvas.Appearance'.Subtle)
                              Layout: ='ButtonCanvas.Layout'.IconBefore
                              Icon: =If(varWaveFilter = ThisItem.Value, "Checkmark", "ChevronRight")
                              BasePaletteColor: =nfPrimary
                              OnSelect: |-
                                =Set(varWaveFilter, ThisItem.Value);
                                ClearCollect(colMigF, Filter(colMig, Wave = varWaveFilter));
                                Set(varWavePickerOpen, false)
