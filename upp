Screens:

  scrAdminWaves:
    Properties:
      Fill: =nfPageBg
      OnVisible: =If(!nfIsAdmin, Navigate(scrMigration), ClearCollect(colMig, migration))
    Children:
      - conPageW:
          Control: GroupContainer
          Variant: AutoLayout
          Properties:
            X: =0
            Y: =0
            Width: =Parent.Width
            Height: =Parent.Height
            Fill: =nfPageBg
            BorderThickness: =0
            LayoutDirection: =LayoutDirection.Vertical
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutJustifyContent: =LayoutJustifyContent.Start
            LayoutGap: =0
          Children:

            # ---------------- Top bar ----------------
            - conTopBarW:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =0
                  Height: =64
                  Fill: =nfWhite
                  BorderThickness: =0
                  DropShadow: =DropShadow.Light
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =16
                  PaddingLeft: =24
                  PaddingRight: =24
                Children:
                  - conBrandW:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Width: =280
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =12
                      Children:
                        - imgLogoW:
                            Control: Image
                            Properties:
                              FillPortions: =0
                              Width: =36
                              Height: =36
                              ImagePosition: =ImagePosition.Fit
                              Image: |-
                                ="data:image/svg+xml;utf8," & EncodeUrl("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 36'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#4F46E5'/><stop offset='1' stop-color='#DB2777'/></linearGradient></defs><rect width='36' height='36' rx='10' fill='url(#g)'/><path d='M9 12.5h7l2 2.5h9v9.5H9z' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linejoin='round'/><path d='M18 23v-5.5M15.5 20l2.5-2.5 2.5 2.5' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>")
                        - conBrandTextW:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =0
                            Children:
                              - txtBrandW:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =20
                                    Text: ="Migration Hub"
                                    Size: =15
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfInk
                                    Wrap: =false
                              - txtBrandSubW:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =16
                                    Text: ="Admin console"
                                    Size: =11
                                    FontColor: =nfMuted
                                    Wrap: =false
                  - conTabsW:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =1
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Center
                        LayoutGap: =8
                      Children:
                        - btnTabWavesW:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =150
                              Height: =36
                              Text: ="Wave control"
                              Appearance: ='ButtonCanvas.Appearance'.Primary
                              Layout: ='ButtonCanvas.Layout'.IconBefore
                              Icon: ="Filter"
                              BasePaletteColor: =nfPrimary
                        - btnTabProgressW:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =130
                              Height: =36
                              Text: ="Progress"
                              Appearance: ='ButtonCanvas.Appearance'.Subtle
                              Layout: ='ButtonCanvas.Layout'.IconBefore
                              Icon: ="DocumentBulletList"
                              BasePaletteColor: =nfPrimary
                              OnSelect: =Navigate(scrAdminProgress)
                  - btnOwnerViewW:
                      Control: Button
                      Properties:
                        FillPortions: =0
                        Width: =130
                        Height: =36
                        Text: ="Owner view"
                        Appearance: ='ButtonCanvas.Appearance'.Secondary
                        Layout: ='ButtonCanvas.Layout'.IconBefore
                        Icon: ="Eye"
                        BasePaletteColor: =nfPrimary
                        OnSelect: =Navigate(scrMigration)
                  - conUserChipW:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Width: =240
                        Height: =44
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.End
                        LayoutGap: =10
                      Children:
                        - conChipTextW:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =0
                            Children:
                              - txtChipNameW:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =18
                                    Text: =User().FullName
                                    Size: =13
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfInk
                                    Align: ='TextCanvas.Align'.End
                                    Wrap: =false
                              - txtChipEmailW:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =16
                                    Text: =User().Email
                                    Size: =11
                                    FontColor: =nfMuted
                                    Align: ='TextCanvas.Align'.End
                                    Wrap: =false
                        - conAvatarW:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =0
                              Width: =36
                              Height: =36
                              Fill: =nfPrimary
                              BorderThickness: =0
                              RadiusTopLeft: =18
                              RadiusTopRight: =18
                              RadiusBottomLeft: =18
                              RadiusBottomRight: =18
                              LayoutDirection: =LayoutDirection.Horizontal
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                            Children:
                              - txtInitialsW:
                                  Control: Text
                                  Properties:
                                    FillPortions: =1
                                    Text: =Upper(Left(User().FullName, 1) & Left(Last(Split(User().FullName, " ")).Value, 1))
                                    Size: =13
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfWhite
                                    Align: ='TextCanvas.Align'.Center
                                    VerticalAlign: =VerticalAlign.Middle
                                    Wrap: =false

            # ---------------- Body ----------------
            - conBodyW:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =1
                  Fill: =RGBA(0, 0, 0, 0)
                  BorderThickness: =0
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =16
                  PaddingLeft: =48
                  PaddingRight: =48
                  PaddingTop: =28
                  PaddingBottom: =24
                Children:
                  - conVisibilityCard:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =150
                        Fill: =nfWhite
                        BorderThickness: =0
                        DropShadow: =DropShadow.Light
                        RadiusTopLeft: =16
                        RadiusTopRight: =16
                        RadiusBottomLeft: =16
                        RadiusBottomRight: =16
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =24
                        PaddingLeft: =28
                        PaddingRight: =28
                        PaddingTop: =20
                        PaddingBottom: =20
                      Children:
                        - conVisText:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =6
                            Children:
                              - txtVisLabel:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =16
                                    Text: ="OWNERS CAN CURRENTLY SEE"
                                    Size: =11
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfMuted
                                    Wrap: =false
                              - txtVisValue:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =36
                                    Text: =nfActiveWaveText
                                    Size: =26
                                    Weight: ='TextCanvas.Weight'.Bold
                                    FontColor: =If(nfShowAllWaves || CountRows(nfActiveWaves) > 0, nfPrimary, nfDanger)
                                    Wrap: =false
                              - txtVisHint:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =40
                                    Text: ="Owners only see file shares in active waves. Activate a wave when its notification emails go out; deactivate it when the wave is done. Changes apply the next time an owner opens the app."
                                    Size: =13
                                    FontColor: =nfMuted
                                    Wrap: =true
                        - btnShowAll:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =240
                              Height: =40
                              Text: =If(nfShowAllWaves, "Switch to per-wave control", "Show all waves")
                              Appearance: =If(nfShowAllWaves, 'ButtonCanvas.Appearance'.Secondary, 'ButtonCanvas.Appearance'.Primary)
                              Layout: ='ButtonCanvas.Layout'.IconBefore
                              Icon: =If(nfShowAllWaves, "Filter", "Eye")
                              BasePaletteColor: =nfPrimary
                              OnSelect: |-
                                =If(
                                    nfShowAllWaves,
                                    // switching back to per-wave control: no confirmation needed
                                    With(
                                        {_row: LookUp(WaveSettings, WaveNumber = "ALL")},
                                        If(
                                            IsBlank(_row),
                                            Patch(WaveSettings, Defaults(WaveSettings), {Title: "All waves", WaveNumber: "ALL", IsActive: false}),
                                            Patch(WaveSettings, {ID: _row.ID}, {IsActive: false})
                                        )
                                    );
                                    Refresh(WaveSettings);
                                    Notify("Per-wave control is on — owners only see active waves.", NotificationType.Information),
                                    // switching to show-all: confirm first
                                    Set(varShowAllConfirm, true)
                                )
                  - conWavesCard:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =1
                        Fill: =nfWhite
                        BorderThickness: =0
                        DropShadow: =DropShadow.Light
                        RadiusTopLeft: =16
                        RadiusTopRight: =16
                        RadiusBottomLeft: =16
                        RadiusBottomRight: =16
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =8
                        PaddingLeft: =28
                        PaddingRight: =28
                        PaddingTop: =22
                        PaddingBottom: =16
                      Children:
                        - txtWavesTitle:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =26
                              Text: ="Waves"
                              Size: =18
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfInk
                              Wrap: =false
                        - txtWavesHint:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =20
                              Text: =If(nfShowAllWaves, "Show all waves is on — every wave is visible regardless of the toggles below. Switch to per-wave control to use them.", "Activate or deactivate each wave. Waves are read from the migration list.")
                              Size: =13
                              FontColor: =If(nfShowAllWaves, nfWarningText, nfMuted)
                              Wrap: =false
                        - galWaves:
                            Control: Gallery
                            Variant: Vertical
                            Properties:
                              FillPortions: =1
                              Items: =Sort(Distinct(colMig, Wave), Value)
                              TemplateSize: =72
                              TemplatePadding: =0
                              ShowScrollbar: =false
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LoadingSpinner: =LoadingSpinner.Data
                              LoadingSpinnerColor: =nfPrimary
                            Children:
                              - conWaveRow:
                                  Control: GroupContainer
                                  Variant: AutoLayout
                                  Properties:
                                    X: =0
                                    Y: =4
                                    Width: =Parent.TemplateWidth
                                    Height: =Parent.TemplateHeight - 8
                                    Fill: =nfPageBg
                                    BorderThickness: =0
                                    RadiusTopLeft: =12
                                    RadiusTopRight: =12
                                    RadiusBottomLeft: =12
                                    RadiusBottomRight: =12
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutJustifyContent: =LayoutJustifyContent.Start
                                    LayoutGap: =16
                                    PaddingLeft: =20
                                    PaddingRight: =16
                                  Children:
                                    - txtWaveName:
                                        Control: Text
                                        Properties:
                                          FillPortions: =0
                                          Width: =110
                                          Height: =24
                                          Text: =ThisItem.Value
                                          Size: =16
                                          Weight: ='TextCanvas.Weight'.Semibold
                                          FontColor: =nfInk
                                          VerticalAlign: =VerticalAlign.Middle
                                          Wrap: =false
                                    - txtWaveStats:
                                        Control: Text
                                        Properties:
                                          FillPortions: =1
                                          Height: =24
                                          Text: |-
                                            =With(
                                                {_rows: Filter(colMig, Wave = ThisItem.Value)},
                                                CountRows(_rows) & " file shares · "
                                                & CountRows(Filter(_rows, OwnerConfirmed = true)) & " owner confirmed · "
                                                & CountRows(Filter(_rows, MigrationStatus.Value = "Site Migrated")) & " migrated"
                                            )
                                          Size: =13
                                          FontColor: =nfMuted
                                          VerticalAlign: =VerticalAlign.Middle
                                          Wrap: =false
                                    - pillWaveState:
                                        Control: GroupContainer
                                        Variant: AutoLayout
                                        Properties:
                                          FillPortions: =0
                                          Width: =120
                                          Height: =28
                                          Fill: =If(nfShowAllWaves || !IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), RGBA(22, 163, 74, 0.14), RGBA(107, 114, 128, 0.16))
                                          BorderThickness: =0
                                          RadiusTopLeft: =14
                                          RadiusTopRight: =14
                                          RadiusBottomLeft: =14
                                          RadiusBottomRight: =14
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutAlignItems: =LayoutAlignItems.Stretch
                                          LayoutJustifyContent: =LayoutJustifyContent.Center
                                        Children:
                                          - txtWaveState:
                                              Control: Text
                                              Properties:
                                                FillPortions: =1
                                                Text: =If(nfShowAllWaves, "Visible (all)", !IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), "Active", "Inactive")
                                                Size: =12
                                                Weight: ='TextCanvas.Weight'.Semibold
                                                FontColor: =If(nfShowAllWaves || !IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), nfSuccessText, nfMuted)
                                                Align: ='TextCanvas.Align'.Center
                                                VerticalAlign: =VerticalAlign.Middle
                                                Wrap: =false
                                    - btnWaveToggle:
                                        Control: Button
                                        Properties:
                                          FillPortions: =0
                                          Width: =140
                                          Height: =36
                                          Text: =If(!IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), "Deactivate", "Activate")
                                          Appearance: =If(!IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), 'ButtonCanvas.Appearance'.Secondary, 'ButtonCanvas.Appearance'.Primary)
                                          Layout: ='ButtonCanvas.Layout'.IconBefore
                                          Icon: =If(!IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), "Dismiss", "Checkmark")
                                          BasePaletteColor: =nfPrimary
                                          OnSelect: |-
                                            =With(
                                                {_row: LookUp(WaveSettings, WaveNumber = ThisItem.Value)},
                                                If(
                                                    IsBlank(_row),
                                                    Patch(WaveSettings, Defaults(WaveSettings), {Title: ThisItem.Value, WaveNumber: ThisItem.Value, IsActive: true}),
                                                    Patch(WaveSettings, {ID: _row.ID}, {IsActive: !_row.IsActive})
                                                )
                                            );
                                            Refresh(WaveSettings);
                                            Notify(ThisItem.Value & If(!IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), " is now active for owners.", " is now hidden from owners."), NotificationType.Success)

      # ---------------- Confirm "show all waves" (overlay) ----------------
      - conScrimW:
          Control: GroupContainer
          Variant: ManualLayout
          Properties:
            X: =0
            Y: =0
            Width: =Parent.Width
            Height: =Parent.Height
            Visible: =varShowAllConfirm
            Fill: =RGBA(17, 24, 39, 0.55)
            BorderThickness: =0
          Children:
            - conDialogW:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  X: =(Parent.Width - Self.Width) / 2
                  Y: =(Parent.Height - Self.Height) / 2
                  Width: =Min(520, Parent.Width - 32)
                  Height: =320
                  Fill: =nfWhite
                  BorderThickness: =0
                  DropShadow: =DropShadow.Bold
                  RadiusTopLeft: =20
                  RadiusTopRight: =20
                  RadiusBottomLeft: =20
                  RadiusBottomRight: =20
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutAlignItems: =LayoutAlignItems.Stretch
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =0
                Children:
                  - conDialogStripW:
                      Control: GroupContainer
                      Variant: ManualLayout
                      Properties:
                        FillPortions: =0
                        Height: =8
                        Fill: =nfPrimary
                        BorderThickness: =0
                        RadiusTopLeft: =20
                        RadiusTopRight: =20
                        RadiusBottomLeft: =0
                        RadiusBottomRight: =0
                  - conDialogBodyW:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =1
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =10
                        PaddingLeft: =36
                        PaddingRight: =36
                        PaddingTop: =28
                        PaddingBottom: =8
                      Children:
                        - txtDialogEyebrowW:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =18
                              Text: ="OWNER VISIBILITY"
                              Size: =11
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfPrimary
                              Wrap: =false
                        - txtDialogTitleW:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =34
                              Text: ="Show all waves to owners?"
                              Size: =22
                              Weight: ='TextCanvas.Weight'.Bold
                              FontColor: =nfInk
                              Wrap: =false
                        - txtDialogBodyW:
                            Control: Text
                            Properties:
                              FillPortions: =1
                              Text: ="Every owner will immediately see all of their file shares in every wave, regardless of the per-wave toggles. Owners with shares in more than one wave will be able to confirm sites for waves that haven't been announced yet. You can switch back to per-wave control at any time."
                              Size: =14
                              FontColor: =nfInk
                              Wrap: =true
                  - conDialogFooterW:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Height: =84
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.End
                        LayoutGap: =12
                        PaddingLeft: =36
                        PaddingRight: =36
                        PaddingTop: =16
                        PaddingBottom: =28
                      Children:
                        - btnCancelW:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =124
                              Height: =40
                              Text: ="Cancel"
                              Appearance: ='ButtonCanvas.Appearance'.Secondary
                              Layout: ='ButtonCanvas.Layout'.TextOnly
                              OnSelect: =Set(varShowAllConfirm, false)
                        - btnConfirmShowAllW:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =200
                              Height: =40
                              Text: ="Yes, show all waves"
                              Appearance: ='ButtonCanvas.Appearance'.Primary
                              Layout: ='ButtonCanvas.Layout'.IconBefore
                              Icon: ="Eye"
                              BasePaletteColor: =nfPrimary
                              OnSelect: |-
                                =With(
                                    {_row: LookUp(WaveSettings, WaveNumber = "ALL")},
                                    If(
                                        IsBlank(_row),
                                        Patch(WaveSettings, Defaults(WaveSettings), {Title: "All waves", WaveNumber: "ALL", IsActive: true}),
                                        Patch(WaveSettings, {ID: _row.ID}, {IsActive: true})
                                    )
                                );
                                Refresh(WaveSettings);
                                Set(varShowAllConfirm, false);
                                Notify("All waves are now visible to owners.", NotificationType.Success)

  # ===================================================================
  #  ADMIN - PROGRESS
  # ===================================================================
  scrAdminProgress:
    Properties:
      Fill: =nfPageBg
      OnVisible: |-
        =If(
            !nfIsAdmin,
            Navigate(scrMigration),
            ClearCollect(colMig, migration);
            Set(varWaveFilter, "");
            ClearCollect(colMigF, colMig);
            Set(varRefreshedAt, Now())
        )
    Children:
      - conPageP:
          Control: GroupContainer
          Variant: AutoLayout
          Properties:
            X: =0
            Y: =0
            Width: =Parent.Width
            Height: =Parent.Height
            Fill: =nfPageBg
            BorderThickness: =0
            LayoutDirection: =LayoutDirection.Vertical
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutJustifyContent: =LayoutJustifyContent.Start
            LayoutGap: =0
          Children:

            # ---------------- Top bar ----------------
            - conTopBarP:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =0
                  Height: =64
                  Fill: =nfWhite
                  BorderThickness: =0
                  DropShadow: =DropShadow.Light
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =16
                  PaddingLeft: =24
                  PaddingRight: =24
                Children:
                  - conBrandP:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Width: =280
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =12
                      Children:
                        - imgLogoP:
                            Control: Image
                            Properties:
                              FillPortions: =0
                              Width: =36
                              Height: =36
                              ImagePosition: =ImagePosition.Fit
                              Image: |-
                                ="data:image/svg+xml;utf8," & EncodeUrl("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 36'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#4F46E5'/><stop offset='1' stop-color='#DB2777'/></linearGradient></defs><rect width='36' height='36' rx='10' fill='url(#g)'/><path d='M9 12.5h7l2 2.5h9v9.5H9z' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linejoin='round'/><path d='M18 23v-5.5M15.5 20l2.5-2.5 2.5 2.5' fill='none' stroke='#FFFFFF' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>")
                        - conBrandTextP:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =0
                            Children:
                              - txtBrandP:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =20
                                    Text: ="Migration Hub"
                                    Size: =15
                                    Weight: ='TextCanvas.Weight'.Semibold
                                    FontColor: =nfInk
                                    Wrap: =false
                              - txtBrandSubP:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =16
                                    Text: ="Admin console"
                                    Size: =11
                                    FontColor: =nfMuted
                                    Wrap: =false
                  - conTabsP:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =1
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Center
                        LayoutGap: =8
                      Children:
                        - btnTabWavesP:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =150
                              Height: =36
                              Text: ="Wave control"
                              Appearance: ='ButtonCanvas.Appearance'.Subtle
