                                  Control: GroupContainer
                                  Variant: AutoLayout
                                  Properties:
                                    FillPortions: =1
                                    Fill: =nfWhite
                                    BorderThickness: =0
                                    DropShadow: =DropShadow.Light
                                    RadiusTopLeft: =16
                                    RadiusTopRight: =16
                                    RadiusBottomLeft: =16
                                    RadiusBottomRight: =16
                                    LayoutDirection: =LayoutDirection.Vertical
                                    LayoutAlignItems: =LayoutAlignItems.Stretch
                                    LayoutJustifyContent: =LayoutJustifyContent.Start
                                    LayoutGap: =8
                                    PaddingLeft: =28
                                    PaddingRight: =28
                                    PaddingTop: =22
                                    PaddingBottom: =12
                                  Children:
