                                          Weight: ='TextCanvas.Weight'.Semibold
                                          FontColor: =nfInk
                                          Wrap: =false
                                    - galWaveStats:
                                        Control: Gallery
                                        Variant: Vertical
                                        Properties:
                                          FillPortions: =1
                                          Items: =Sort(Distinct(colMigF, Wave), Value)
                                          TemplateSize: =44
                                          TemplatePadding: =0
                                          ShowScrollbar: =false
                                          Fill: =RGBA(0, 0, 0, 0)
                                          BorderThickness: =0
                                        Children:
                                          - conWaveStatRow:
                                              Control: GroupContainer
                                              Variant: AutoLayout
                                              Properties:
                                                X: =0
                                                Y: =0
                                                Width: =Parent.TemplateWidth
                                                Height: =Parent.TemplateHeight
                                                Fill: =RGBA(0, 0, 0, 0)
                                                BorderThickness: =0
                                                LayoutDirection: =LayoutDirection.Horizontal
                                                LayoutAlignItems: =LayoutAlignItems.Center
                                                LayoutJustifyContent: =LayoutJustifyContent.Start
                                                LayoutGap: =12
                                              Children:
                                                - txtWsName:
                                                    Control: Text
                                                    Properties:
                                                      FillPortions: =0
                                                      Width: =80
                                                      Height: =24
                                                      Text: =ThisItem.Value
                                                      Size: =13
                                                      Weight: ='TextCanvas.Weight'.Semibold
                                                      FontColor: =nfInk
                                                      VerticalAlign: =VerticalAlign.Middle
                                                      Wrap: =false
                                                - pillWsState:
                                                    Control: GroupContainer
                                                    Variant: AutoLayout
                                                    Properties:
                                                      FillPortions: =0
                                                      Width: =96
                                                      Height: =24
                                                      Fill: =If(nfShowAllWaves || !IsBlank(LookUp(nfActiveWaves, WaveNumber = ThisItem.Value)), RGBA(22, 163, 74, 0.14), RGBA(107, 114, 128, 0.16))
