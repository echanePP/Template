{"version":"0.3.0","body":"/**\n * FillKpMailingList - Member Initiative Program\n * Writes every row of a KP mailing list into the table \"KPMailingListReport\"\n * of a COPY of the template, in one call.\n *\n * Card numbers, Member IDs and ZIPs are written as TEXT: the target cells are\n * formatted \"@\" BEFORE the values go in. Writing first would let Excel turn a\n * 16+ digit card number into 6.92E+20 and lose its last digits.\n *\n * rowsJson: JSON array of rows, each an array of 11 values in template order:\n *   Member ID, First Name, Last Name, Address, City, State, ZIP,\n *   Program (Health Screening), Chosen GC Type, GC $Amount, Gift Card Number\n * Returns the number of rows written.\n */\nfunction main(workbook: ExcelScript.Workbook, rowsJson: string): number {\n    const rows: (string | number)[][] = JSON.parse(rowsJson);\n    const table = workbook.getTable(\"KPMailingListReport\");\n    if (!table) {\n        throw new Error(\"The template has no table named KPMailingListReport.\");\n    }\n    const cols = table.getHeaderRowRange().getColumnCount();\n    const amountCol = 9;                           // GC $Amount - the only number column\n    if (rows.length === 0) {\n        return 0;\n    }\n    rows.forEach((r, i) => {\n        if (r.length !== cols) {\n            throw new Error(`Row ${i + 1} has ${r.length} values; the table has ${cols} columns.`);\n        }\n    });\n    const header = table.getHeaderRowRange();\n    const target = header.getOffsetRange(1, 0).getResizedRange(rows.length - 1, 0);\n    const formats = rows.map(() => {\n        const f: string[] = [];\n        for (let c = 0; c < cols; c++) {\n            f.push(c === amountCol ? \"$#,##0.00\" : \"@\");\n        }\n        return f;\n    });\n    target.setNumberFormats(formats);               // text format FIRST\n    const values = rows.map(r => r.map((v, c) => (c === amountCol ? Number(v) : String(v))));\n    target.setValues(values);\n    table.resize(header.getResizedRange(rows.length, 0));\n    return rows.length;\n}","description":"","parameterInfo":"{\"version\":1,\"originalParameterOrder\":[{\"name\":\"rowsJson\",\"index\":0}],\"parameterSchema\":{\"type\":\"object\",\"required\":[\"rowsJson\"],\"properties\":{\"rowsJson\":{\"type\":\"string\"}}},\"returnSchema\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"number\"}}},\"signature\":{\"comment\":\"FillKpMailingList - Member Initiative Program\\nWrites every row of a KP mailing list into the table \\\"KPMailingListReport\\\"\\nof a COPY of the template, in one call.\\n\\nCard numbers, Member IDs and ZIPs are written as TEXT: the target cells are\\nformatted \\\"@\\\" BEFORE the values go in. Writing first would let Excel turn a\\n16+ digit card number into 6.92E+20 and lose its last digits.\\n\\nrowsJson: JSON array of rows, each an array of 11 values in template order:\\n   Member ID, First Name, Last Name, Address, City, State, ZIP,\\n   Program (Health Screening), Chosen GC Type, GC $Amount, Gift Card Number\\nReturns the number of rows written.\",\"parameters\":[{\"name\":\"workbook\",\"comment\":\"\"},{\"name\":\"rowsJson\",\"comment\":\"\"}]}}","apiInfo":"{\"variant\":\"synchronous\",\"variantVersion\":2}"}