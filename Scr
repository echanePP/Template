Screens:

  ScrOwnerDrive:
    Properties:
      Fill: =nfPageBg
      OnVisible: |-
        =Set(varLookupEmail, User().Email);
        Set(varRow, LookUp(HomeDriveMigration, Email = varLookupEmail || Email = Lower(varLookupEmail)));
        Set(varVDI, Lower(Trim(Coalesce(varRow.HasVM, ""))) = "yes");
        Set(varWaveOpen, nfShowAllWaves || Coalesce(LookUp(HomeDriveWaveSettings, WaveNumber = varRow.Wave && IsActive = true).IsActive, false));
        Set(
            varAns,
            {
                Freq: Coalesce(varRow.FileUsageFrequency.Value, ""),
                Req: Coalesce(varRow.RequiredForOperations.Value, ""),
                Dep: Coalesce(varRow.OtherTeamsDepend.Value, ""),
                Imp: Coalesce(varRow.LocationChangeImpact.Value, ""),
                Acc: Coalesce(varRow.AllFilesAccessible.Value, ""),
                Arc: Coalesce(varRow.CanArchiveOlder.Value, "")
            }
        );
        Set(varEdit, !Coalesce(varRow.ResponseSubmitted, false));
        Set(varPreview, false);
        Set(varDoneOpen, false)
    Children:
      - conShellOD:
          Control: GroupContainer
          Variant: AutoLayout
          Properties:
            X: =0
            Y: =0
            Width: =Parent.Width
            Height: =Parent.Height
            Fill: =nfPageBg
            BorderThickness: =0
            DropShadow: =DropShadow.None
            LayoutDirection: =LayoutDirection.Vertical
            LayoutAlignItems: =LayoutAlignItems.Stretch
            LayoutJustifyContent: =LayoutJustifyContent.Start
            LayoutGap: =0
            PaddingTop: =0
            PaddingRight: =0
            PaddingBottom: =0
            PaddingLeft: =0
          Children:
            - conHeaderOD:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =0
                  Height: =56
                  Fill: =nfWhite
                  BorderThickness: =0
                  DropShadow: =DropShadow.None
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =14
                  PaddingTop: =0
                  PaddingRight: =If(nfNarrow, 12, 24)
                  PaddingBottom: =0
                  PaddingLeft: =If(nfNarrow, 12, 24)
                Children:
                  - imgLogoOD:
                      Control: Image
                      Properties:
                        FillPortions: =0
                        Width: =34
                        Height: =34
                        ImagePosition: =ImagePosition.Fit
                        Image: |-
                          ="data:image/svg+xml;utf8," & EncodeUrl(
                              "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 36 36'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#38BDF8'/><stop offset='1' stop-color='#0B6BCB'/></linearGradient></defs><rect width='36' height='36' rx='10' fill='url(#g)'/><g><animateTransform attributeName='transform' type='translate' values='0 0;0 -1.5;0 0' dur='4s' repeatCount='indefinite'/><path d='M11.5 24h13a4.5 4.5 0 0 0 .6-8.96A6 6 0 0 0 13.6 15.4A4.3 4.3 0 0 0 11.5 24z' fill='#FFFFFF'/><path d='M18 22v-5M15.8 19.2l2.2-2.2l2.2 2.2' fill='none' stroke='#0B6BCB' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/></g></svg>"
                          )
                  - conBrandOD:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =1
                        Height: =38
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutJustifyContent: =LayoutJustifyContent.Center
                        LayoutGap: =0
                        PaddingTop: =0
                        PaddingRight: =0
                        PaddingBottom: =0
                        PaddingLeft: =0
                      Children:
                        - txtBrandOD:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =20
                              Text: |-
                                ="H: drive to OneDrive"
                              Size: =15
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfInk
                              VerticalAlign: =VerticalAlign.Middle
                              Wrap: =false
                        - txtBrandSubOD:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =16
                              Visible: =!nfNarrow
                              Text: ="Home drive migration"
                              Size: =11
                              FontColor: =nfMuted
                              VerticalAlign: =VerticalAlign.Middle
                              Wrap: =false
                  - conPreviewOD:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Width: =304
                        Height: =34
                        Visible: =nfIsAdmin && !nfNarrow
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =8
                        PaddingTop: =0
                        PaddingRight: =0
                        PaddingBottom: =0
                        PaddingLeft: =0
                      Children:
                        - txtPreviewOD:
                            Control: TextInput
                            Properties:
                              FillPortions: =0
                              Width: =210
                              Height: =32
                              Value: =""
                              Placeholder: ="Preview a user by email"
                        - btnPreviewOD:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =86
                              Height: =32
                              Text: ="Preview"
                              Appearance: ='ButtonCanvas.Appearance'.Outline
                              BasePaletteColor: =nfPrimary
                              DisplayMode: =If(IsBlank(Trim(txtPreviewOD.Value)), DisplayMode.Disabled, DisplayMode.Edit)
                              OnSelect: |-
                                =Set(varLookupEmail, Trim(txtPreviewOD.Value));
                                Set(varRow, LookUp(HomeDriveMigration, Email = varLookupEmail || Email = Lower(varLookupEmail)));
                                Set(varVDI, Lower(Trim(Coalesce(varRow.HasVM, ""))) = "yes");
                                Set(varWaveOpen, nfShowAllWaves || Coalesce(LookUp(HomeDriveWaveSettings, WaveNumber = varRow.Wave && IsActive = true).IsActive, false));
                                Set(
                                    varAns,
                                    {
                                        Freq: Coalesce(varRow.FileUsageFrequency.Value, ""),
                                        Req: Coalesce(varRow.RequiredForOperations.Value, ""),
                                        Dep: Coalesce(varRow.OtherTeamsDepend.Value, ""),
                                        Imp: Coalesce(varRow.LocationChangeImpact.Value, ""),
                                        Acc: Coalesce(varRow.AllFilesAccessible.Value, ""),
                                        Arc: Coalesce(varRow.CanArchiveOlder.Value, "")
                                    }
                                );
                                Set(varEdit, !Coalesce(varRow.ResponseSubmitted, false));
                                Set(varPreview, true);
                                Set(varDoneOpen, false)
                  - conTabsOD:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Width: =300
                        Height: =34
                        Visible: =nfIsAdmin
                        Fill: =RGBA(0, 0, 0, 0)
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =6
                        PaddingTop: =0
                        PaddingRight: =0
                        PaddingBottom: =0
                        PaddingLeft: =0
                      Children:
                        - btnTabMyDriveOD:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =96
                              Height: =32
                              Text: ="My drive"
                              Appearance: ='ButtonCanvas.Appearance'.Primary
                              BasePaletteColor: =nfPrimary
                              OnSelect: =Navigate(ScrOwnerDrive, ScreenTransition.Fade)
                        - btnTabWavesOD:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =96
                              Height: =32
                              Text: ="Waves"
                              Appearance: ='ButtonCanvas.Appearance'.Subtle
                              BasePaletteColor: =nfPrimary
                              OnSelect: =Navigate(scrWaves, ScreenTransition.Fade)
                        - btnTabDashOD:
                            Control: Button
                            Properties:
                              FillPortions: =0
                              Width: =96
                              Height: =32
                              Text: ="Dashboard"
                              Appearance: ='ButtonCanvas.Appearance'.Subtle
                              BasePaletteColor: =nfPrimary
                              OnSelect: =Navigate(scrDashboard, ScreenTransition.Fade)
                  - conAvatarOD:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Width: =34
                        Height: =34
                        Fill: =nfPrimarySoft
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        RadiusTopLeft: =17
                        RadiusTopRight: =17
                        RadiusBottomLeft: =17
                        RadiusBottomRight: =17
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =0
                        PaddingTop: =0
                        PaddingRight: =0
                        PaddingBottom: =0
                        PaddingLeft: =0
                      Children:
                        - txtAvatarOD:
                            Control: Text
                            Properties:
                              FillPortions: =1
                              Height: =34
                              Text: =Upper(Left(User().FullName, 1) & Left(Last(Split(User().FullName, " ")).Value, 1))
                              Size: =12
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfPrimary
                              Align: ='TextCanvas.Align'.Center
                              VerticalAlign: =VerticalAlign.Middle
                              Wrap: =false
            - conPreviewBarOD:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =0
                  Height: =40
                  Visible: =varPreview
                  Fill: =nfWarnSoft
                  BorderThickness: =0
                  DropShadow: =DropShadow.None
                  LayoutDirection: =LayoutDirection.Horizontal
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =12
                  PaddingTop: =0
                  PaddingRight: =24
                  PaddingBottom: =0
                  PaddingLeft: =24
                Children:
                  - txtPreviewBarOD:
                      Control: Text
                      Properties:
                        FillPortions: =1
                        Height: =36
                        Text: ="Previewing as " & varLookupEmail & ". Answers are not saved in preview."
                        Size: =13
                        Weight: ='TextCanvas.Weight'.Semibold
                        FontColor: =nfWarn
                        VerticalAlign: =VerticalAlign.Middle
                        Wrap: =false
                  - btnExitPreviewOD:
                      Control: Button
                      Properties:
                        FillPortions: =0
                        Width: =116
                        Height: =28
                        Text: ="Exit preview"
                        Appearance: ='ButtonCanvas.Appearance'.Outline
                        BasePaletteColor: =nfWarn
                        OnSelect: |-
                          =Set(varLookupEmail, User().Email);
                          Set(varRow, LookUp(HomeDriveMigration, Email = varLookupEmail || Email = Lower(varLookupEmail)));
                          Set(varVDI, Lower(Trim(Coalesce(varRow.HasVM, ""))) = "yes");
                          Set(varWaveOpen, nfShowAllWaves || Coalesce(LookUp(HomeDriveWaveSettings, WaveNumber = varRow.Wave && IsActive = true).IsActive, false));
                          Set(
                              varAns,
                              {
                                  Freq: Coalesce(varRow.FileUsageFrequency.Value, ""),
                                  Req: Coalesce(varRow.RequiredForOperations.Value, ""),
                                  Dep: Coalesce(varRow.OtherTeamsDepend.Value, ""),
                                  Imp: Coalesce(varRow.LocationChangeImpact.Value, ""),
                                  Acc: Coalesce(varRow.AllFilesAccessible.Value, ""),
                                  Arc: Coalesce(varRow.CanArchiveOlder.Value, "")
                              }
                          );
                          Set(varEdit, !Coalesce(varRow.ResponseSubmitted, false));
                          Set(varPreview, false);
                          Set(varDoneOpen, false);
                          Reset(txtPreviewOD)
            - conBodyOD:
                Control: GroupContainer
                Variant: AutoLayout
                Properties:
                  FillPortions: =1
                  Fill: =RGBA(0, 0, 0, 0)
                  BorderThickness: =0
                  DropShadow: =DropShadow.None
                  LayoutDirection: =LayoutDirection.Vertical
                  LayoutAlignItems: =LayoutAlignItems.Center
                  LayoutJustifyContent: =LayoutJustifyContent.Start
                  LayoutGap: =12
                  PaddingTop: =16
                  PaddingRight: =0
                  PaddingBottom: =16
                  PaddingLeft: =0
                  LayoutOverflowY: =If(nfNarrow, LayoutOverflow.Scroll, LayoutOverflow.Hide)
                Children:
                  - conEmptyOD:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Width: =Min(1160, Parent.Width - If(nfNarrow, 24, 48))
                        Height: =320
                        Visible: =IsBlank(varRow.ID)
                        Fill: =nfWhite
                        BorderColor: =nfBorder
                        BorderThickness: =1
                        DropShadow: =DropShadow.None
                        RadiusTopLeft: =14
                        RadiusTopRight: =14
                        RadiusBottomLeft: =14
                        RadiusBottomRight: =14
                        LayoutDirection: =LayoutDirection.Vertical
                        LayoutAlignItems: =LayoutAlignItems.Stretch
                        LayoutJustifyContent: =LayoutJustifyContent.Center
                        LayoutGap: =10
                        PaddingTop: =32
                        PaddingRight: =32
                        PaddingBottom: =32
                        PaddingLeft: =32
                      Children:
                        - imgEmptyOD:
                            Control: Image
                            Properties:
                              FillPortions: =0
                              Height: =110
                              ImagePosition: =ImagePosition.Fit
                              Image: |-
                                ="data:image/svg+xml;utf8," & EncodeUrl(
                                    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><circle cx='60' cy='60' r='56' fill='#E6F0FB'/><path d='M28 46h22l6 7h36v33H28z' fill='#FFFFFF' stroke='#9FBCDB' stroke-width='2' stroke-linejoin='round'/><g><animateTransform attributeName='transform' type='rotate' values='-10 60 60;10 60 60;-10 60 60' dur='3.2s' repeatCount='indefinite'/><circle cx='66' cy='66' r='15' fill='#FFFFFF' stroke='#0B6BCB' stroke-width='5'/><path d='M77 77l12 12' stroke='#0B6BCB' stroke-width='7' stroke-linecap='round'/></g></svg>"
                                )
                        - txtEmptyTitleOD:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =28
                              Text: ="No home drive is linked to this account"
                              Size: =20
                              Weight: ='TextCanvas.Weight'.Semibold
                              FontColor: =nfInk
                              Align: ='TextCanvas.Align'.Center
                              VerticalAlign: =VerticalAlign.Middle
                              Wrap: =false
                        - txtEmptyBodyOD:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =44
                              Text: ="We match home drives to your work email (" & varLookupEmail & "). If you expected to see yours, contact the IT service desk and include this email address."
                              Size: =14
                              FontColor: =nfMuted
                              Align: ='TextCanvas.Align'.Center
                              VerticalAlign: =VerticalAlign.Middle
                              Wrap: =true
                        - txtEmptyAdminOD:
                            Control: Text
                            Properties:
                              FillPortions: =0
                              Height: =20
                              Visible: =nfIsAdmin
                              Text: ="Admins can use Preview in the header to see what a specific user sees."
                              Size: =12
                              FontColor: =nfPrimary
                              Align: ='TextCanvas.Align'.Center
                              VerticalAlign: =VerticalAlign.Middle
                              Wrap: =false
                  - conHeroOD:
                      Control: GroupContainer
                      Variant: AutoLayout
                      Properties:
                        FillPortions: =0
                        Width: =Min(1160, Parent.Width - If(nfNarrow, 24, 48))
                        Height: =If(nfNarrow, 132, 100)
                        Visible: =!IsBlank(varRow.ID)
                        Fill: =nfInk
                        BorderThickness: =0
                        DropShadow: =DropShadow.None
                        RadiusTopLeft: =16
                        RadiusTopRight: =16
                        RadiusBottomLeft: =16
                        RadiusBottomRight: =16
                        LayoutDirection: =LayoutDirection.Horizontal
                        LayoutAlignItems: =LayoutAlignItems.Center
                        LayoutJustifyContent: =LayoutJustifyContent.Start
                        LayoutGap: =20
                        PaddingTop: =12
                        PaddingRight: =24
                        PaddingBottom: =12
                        PaddingLeft: =24
                      Children:
                        - conHeroTextOD:
                            Control: GroupContainer
                            Variant: AutoLayout
                            Properties:
                              FillPortions: =1
                              Fill: =RGBA(0, 0, 0, 0)
                              BorderThickness: =0
                              DropShadow: =DropShadow.None
                              LayoutDirection: =LayoutDirection.Vertical
                              LayoutAlignItems: =LayoutAlignItems.Stretch
                              LayoutJustifyContent: =LayoutJustifyContent.Center
                              LayoutGap: =6
                              PaddingTop: =0
                              PaddingRight: =0
                              PaddingBottom: =0
                              PaddingLeft: =0
                            Children:
                              - txtHeadlineOD:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =If(nfNarrow, 44, 28)
                                    Text: |-
                                      ="Hi " & First(Split(If(varPreview, Coalesce(varRow.Name, varRow.Email), User().FullName), " ")).Value & If(Coalesce(varRow.MigrationStatus.Value, "Not Started") = "Completed", ", your files are in OneDrive", ", your H: drive is moving to OneDrive")
                                    Size: =If(nfNarrow, 16, 20)
                                    Weight: ='TextCanvas.Weight'.Bold
                                    FontColor: =nfWhite
                                    VerticalAlign: =VerticalAlign.Middle
                                    Wrap: =true
                              - txtDateLineOD:
                                  Control: Text
                                  Properties:
                                    FillPortions: =0
                                    Height: =If(nfNarrow, 36, 18)
                                    Text: |-
                                      =If(
                                          IsBlank(varRow.MigrationDate),
                                          "Your migration date hasn't been set yet. We'll email you once it is.",
                                          "Scheduled for " & Text(varRow.MigrationDate, "dddd, mmmm d, yyyy") &
                                          If(DateDiff(Today(), varRow.MigrationDate, TimeUnit.Days) > 1, ", in " & DateDiff(Today(), varRow.MigrationDate, TimeUnit.Days) & " days.", DateDiff(Today(), varRow.MigrationDate, TimeUnit.Days) = 1, ", tomorrow.", DateDiff(Today(), varRow.MigrationDate, TimeUnit.Days) = 0, ", today.", ".")
                                      )
                                    Size: =13
                                    FontColor: |-
                                      =ColorValue("#D5E3F0")
                                    VerticalAlign: =VerticalAlign.Middle
                                    Wrap: =true
                              - conHeroPillsOD:
                                  Control: GroupContainer
                                  Variant: AutoLayout
                                  Properties:
                                    FillPortions: =0
                                    Height: =22
                                    Fill: =RGBA(0, 0, 0, 0)
                                    BorderThickness: =0
                                    DropShadow: =DropShadow.None
                                    LayoutDirection: =LayoutDirection.Horizontal
                                    LayoutAlignItems: =LayoutAlignItems.Center
                                    LayoutJustifyContent: =LayoutJustifyContent.Start
                                    LayoutGap: =6
                                    PaddingTop: =0
                                    PaddingRight: =0
                                    PaddingBottom: =0
                                    PaddingLeft: =0
                                  Children:
                                    - pilStatusOD:
                                        Control: GroupContainer
                                        Variant: AutoLayout
                                        Properties:
                                          FillPortions: =0
                                          Width: =Len(Coalesce(varRow.MigrationStatus.Value, "Not Started")) * 7 + 26
                                          Height: =22
                                          Fill: |-
                                            =Switch(Coalesce(varRow.MigrationStatus.Value, "Not Started"), "Completed", nfSuccessSoft, "In progress", nfWarnSoft, ColorValue("#E2E8F0"))
                                          BorderThickness: =0
                                          DropShadow: =DropShadow.None
                                          RadiusTopLeft: =11
                                          RadiusTopRight: =11
                                          RadiusBottomLeft: =11
                                          RadiusBottomRight: =11
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutAlignItems: =LayoutAlignItems.Center
                                          LayoutJustifyContent: =LayoutJustifyContent.Start
                                          LayoutGap: =0
                                          PaddingTop: =0
                                          PaddingRight: =10
                                          PaddingBottom: =0
                                          PaddingLeft: =10
                                        Children:
                                          - pilStatusODT:
                                              Control: Text
                                              Properties:
                                                FillPortions: =1
                                                Height: =22
                                                Text: =Coalesce(varRow.MigrationStatus.Value, "Not Started")
                                                Size: =12
                                                Weight: ='TextCanvas.Weight'.Semibold
                                                FontColor: =Switch(Coalesce(varRow.MigrationStatus.Value, "Not Started"), "Completed", nfSuccess, "In progress", nfWarn, nfInk)
                                                Align: ='TextCanvas.Align'.Center
                                                VerticalAlign: =VerticalAlign.Middle
                                                Wrap: =false
                                    - pilWaveOD:
                                        Control: GroupContainer
                                        Variant: AutoLayout
                                        Properties:
                                          FillPortions: =0
                                          Width: =Len(Coalesce(varRow.Wave, "No wave yet")) * 7 + 26
                                          Height: =22
                                          Fill: |-
                                            =ColorValue("#24466B")
                                          BorderThickness: =0
                                          DropShadow: =DropShadow.None
                                          RadiusTopLeft: =11
                                          RadiusTopRight: =11
                                          RadiusBottomLeft: =11
                                          RadiusBottomRight: =11
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutAlignItems: =LayoutAlignItems.Center
                                          LayoutJustifyContent: =LayoutJustifyContent.Start
                                          LayoutGap: =0
                                          PaddingTop: =0
                                          PaddingRight: =10
                                          PaddingBottom: =0
                                          PaddingLeft: =10
                                        Children:
                                          - pilWaveODT:
                                              Control: Text
                                              Properties:
                                                FillPortions: =1
                                                Height: =22
                                                Text: =Coalesce(varRow.Wave, "No wave yet")
                                                Size: =12
                                                Weight: ='TextCanvas.Weight'.Semibold
                                                FontColor: =nfWhite
                                                Align: ='TextCanvas.Align'.Center
                                                VerticalAlign: =VerticalAlign.Middle
                                                Wrap: =false
                                    - pilVdiOD:
                                        Control: GroupContainer
                                        Variant: AutoLayout
                                        Properties:
                                          FillPortions: =0
                                          Width: =Len("VDI user") * 7 + 26
                                          Height: =22
                                          Visible: =varVDI
                                          Fill: |-
                                            =ColorValue("#24466B")
                                          BorderThickness: =0
                                          DropShadow: =DropShadow.None
                                          RadiusTopLeft: =11
                                          RadiusTopRight: =11
                                          RadiusBottomLeft: =11
                                          RadiusBottomRight: =11
                                          LayoutDirection: =LayoutDirection.Horizontal
                                          LayoutAlignItems: =LayoutAlignItems.Center
                                          LayoutJustifyContent: =LayoutJustifyContent.Start
                                          LayoutGap: =0
                                          PaddingTop: =0
                                          PaddingRight: =10
                                          PaddingBottom: =0
                                          PaddingLeft: =10
                                        Children:
                                          - pilVdiODT:
                                              Control: Text
                                              Properties:
                                                FillPortions: =1
                                                Height: =22
                                                Text: ="VDI user"
                                                Size: =12
                                                Weight: ='TextCanvas.Weight'.Semibold
                                                FontColor: =nfWhite
                                                Align: ='TextCanvas.Align'.Center
                                                VerticalAlign: =VerticalAlign.Middle
                                                Wrap: =false
                        - imgHeroOD:
                            Control: Image
                            Properties:
                              FillPortions: =0
                              Width: =250
                              Height: =84
                              Visible: =App.Width >= 640
                              ImagePosition: =ImagePosition.Fit
                              Image: |-
